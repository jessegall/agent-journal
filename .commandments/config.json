{
    "$schema": "./config.schema.json",
    "paths": [
        "src/core"
    ],
    "base": "main",
    "disable": {
        "languages": [
            "php",
            "csharp",
            "typescript",
            "go"
        ]
    },
    "detectors": [
        "PlainViewerTextDetector",
        "PlainServerTextDetector",
        "PlainJournalTextDetector",
        "PlainViewerScriptTextDetector",
        "PlainViewerPageTextDetector",
        "SentenceLabelDetector",
        "SentenceLabelScriptDetector",
        "PoeticTypeNameDetector",
        "SentenceTypeNameDetector",
        "PoeticMethodNameDetector",
        "SentenceMethodNameDetector",
        "SentenceVariableNameDetector",
        "SentenceParameterNameDetector",
        "PoeticVariableNameDetector",
        "PoeticParameterNameDetector",
        "UnitlessQuantityNameDetector",
        "LongDocstringLineDetector",
        "PlainSettingsGroupTitleDetector",
        "PlainSettingsTabTitleDetector",
        "SqlOutsideDatabaseLayerDetector"
    ],
    "parallel": 2,
    "configure": {
        "python/NamespaceDependencyDetector": [
            {
                "layer": [
                    "core.base"
                ]
            },
            {
                "layer": [
                    "core.actors",
                    [
                        "core.base"
                    ]
                ]
            },
            {
                "layer": [
                    "core.environments",
                    [
                        "core.base",
                        "core.actors"
                    ]
                ]
            },
            {
                "layer": [
                    "core.agents",
                    [
                        "core.base",
                        "core.actors",
                        "core.environments"
                    ]
                ]
            },
            {
                "layer": [
                    "core.tasks",
                    [
                        "core.base",
                        "core.actors",
                        "core.environments",
                        "core.agents"
                    ]
                ]
            },
            {
                "layer": [
                    "core.plans",
                    [
                        "core.base",
                        "core.actors",
                        "core.environments",
                        "core.agents",
                        "core.tasks"
                    ]
                ]
            },
            {
                "layer": [
                    "core.messages",
                    [
                        "core.base",
                        "core.actors",
                        "core.environments",
                        "core.agents"
                    ]
                ]
            },
            {
                "layer": [
                    "core.settings",
                    [
                        "core.base",
                        "core.actors"
                    ]
                ]
            },
            {
                "layer": [
                    "core.journal_module",
                    [
                        "core.base",
                        "core.actors",
                        "core.settings"
                    ]
                ]
            },
            {
                "layer": [
                    "core.journal",
                    [
                        "core.base"
                    ]
                ]
            }
        ],
        "vue/ComponentBudgetDetector": [
            {
                "elements": [
                    50
                ]
            }
        ]
    }
}
