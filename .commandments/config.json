{
    "$schema": "./config.schema.json",
    "paths": [
        "src/core",
        "src/suites",
        "src/install",
        "src/server",
        "tests",
        "tools/journal-hook",
        "src/viewer"
    ],
    "base": "main",
    "disable": {
        "languages": [
            "php",
            "csharp",
            "typescript"
        ]
    },
    "detectors": [
        "naming_PlainViewerTextDetector",
        "naming_PlainJournalTextDetector",
        "naming_PlainViewerScriptTextDetector",
        "naming_PlainViewerPageTextDetector",
        "naming_SentenceLabelDetector",
        "naming_SentenceLabelScriptDetector",
        "naming_PoeticTypeNameDetector",
        "naming_SentenceTypeNameDetector",
        "naming_PoeticMethodNameDetector",
        "naming_SentenceMethodNameDetector",
        "naming_SentenceVariableNameDetector",
        "naming_SentenceParameterNameDetector",
        "naming_PoeticVariableNameDetector",
        "naming_PoeticParameterNameDetector",
        "naming_UnitlessQuantityNameDetector",
        "naming_LongDocstringLineDetector",
        "naming_PlainSettingsTabTitleDetector",
        "architecture_core_SqlLayerDetector",
        "naming_GoPoeticTypeNameDetector",
        "naming_GoPoeticMethodNameDetector",
        "naming_GoPoeticVariableNameDetector",
        "naming_GoPoeticParameterNameDetector",
        "naming_GoSentenceTypeNameDetector",
        "naming_GoSentenceMethodNameDetector",
        "naming_GoSentenceVariableNameDetector",
        "naming_GoSentenceParameterNameDetector",
        "naming_GoUnitlessQuantityNameDetector",
        "syntax_OneElementTupleDetector",
        "test_UnitTestBoundaryDetector"
    ],
    "parallel": 2,
    "configure": {
        "python/NamespaceDependencyDetector": [
            {
                "layer": [
                    "core.base"
                ]
            },
            {
                "layer": [
                    "core.modules.actors",
                    [
                        "core.base"
                    ]
                ]
            },
            {
                "layer": [
                    "core.modules.environments",
                    [
                        "core.base",
                        "core.modules.actors"
                    ]
                ]
            },
            {
                "layer": [
                    "core.modules.agents",
                    [
                        "core.base",
                        "core.modules.actors",
                        "core.modules.environments"
                    ]
                ]
            },
            {
                "layer": [
                    "core.modules.tasks",
                    [
                        "core.base",
                        "core.modules.actors",
                        "core.modules.environments",
                        "core.modules.agents"
                    ]
                ]
            },
            {
                "layer": [
                    "core.modules.plans",
                    [
                        "core.base",
                        "core.modules.actors",
                        "core.modules.environments",
                        "core.modules.agents",
                        "core.modules.tasks"
                    ]
                ]
            },
            {
                "layer": [
                    "core.modules.messages",
                    [
                        "core.base",
                        "core.modules.actors",
                        "core.modules.environments",
                        "core.modules.agents"
                    ]
                ]
            },
            {
                "layer": [
                    "core.modules.settings",
                    [
                        "core.base",
                        "core.modules.actors"
                    ]
                ]
            },
            {
                "layer": [
                    "core.journal_module",
                    [
                        "core.base",
                        "core.modules.actors",
                        "core.modules.settings"
                    ]
                ]
            },
            {
                "layer": [
                    "core.journal",
                    [
                        "core.base"
                    ]
                ]
            },
            {
                "layer": [
                    "server",
                    [
                        "core"
                    ]
                ]
            }
        ],
        "vue/ComponentBudgetDetector": [
            {
                "elements": [
                    50
                ]
            }
        ],
        "naming_PoeticTypeNameDetector": [
            {
                "judges": [
                    "tests"
                ]
            }
        ],
        "naming_PoeticMethodNameDetector": [
            {
                "judges": [
                    "tests"
                ]
            }
        ],
        "naming_PoeticVariableNameDetector": [
            {
                "judges": [
                    "tests"
                ]
            }
        ],
        "naming_PoeticParameterNameDetector": [
            {
                "judges": [
                    "tests"
                ]
            }
        ],
        "naming_LongDocstringLineDetector": [
            {
                "judges": [
                    "tests"
                ]
            }
        ],
        "syntax_OneElementTupleDetector": [
            {
                "judges": [
                    "tests"
                ]
            }
        ],
        "test_UnitTestBoundaryDetector": [
            {
                "judges": [
                    "tests"
                ]
            }
        ]
    },
    "exclude": [
        "tests",
        "tools/journal-hook/testdata",
        "src/viewer/tests/sample-window",
        "src/core/modules/viewer/web/dist",
        "src/suites/coding/web/dist"
    ]
}
