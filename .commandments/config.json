{
    "$schema": "./config.schema.json",
    "paths": [
        "src"
    ],
    "exclude": [
        ".venv",
        "__pycache__",
        "src/web/dist",
        "src/web/dist-demo",
        ".claude/worktrees"
    ],
    "disable": {
        "languages": [
            "php",
            "typescript",
            "csharp"
        ]
    },
    "detectors": [
        "PlainViewerTextDetector",
        "PlainServerTextDetector"
    ],
    "parallel": 2,
    "configure": {
        "frontend/ComponentBudgetDetector": [
            {
                "elements": [
                    50
                ]
            }
        ],
        "python/NamespaceDependencyDetector": [
            {
                "layer": [
                    "supervisor"
                ]
            },
            {
                "layer": [
                    "resources"
                ]
            },
            {
                "layer": [
                    "engine",
                    [
                        "resources",
                        "supervisor",
                        "install"
                    ]
                ]
            },
            {
                "layer": [
                    "controllers",
                    [
                        "resources",
                        "engine"
                    ]
                ]
            },
            {
                "layer": [
                    "providers",
                    [
                        "resources",
                        "engine",
                        "controllers",
                        "supervisor"
                    ]
                ]
            },
            {
                "layer": [
                    "agents",
                    [
                        "resources",
                        "engine",
                        "controllers",
                        "providers",
                        "supervisor"
                    ]
                ]
            },
            {
                "layer": [
                    "runner",
                    [
                        "resources",
                        "engine",
                        "controllers",
                        "providers",
                        "agents",
                        "supervisor",
                        "features",
                        "migrations",
                        "overview"
                    ]
                ]
            },
            {
                "layer": [
                    "overview",
                    [
                        "resources",
                        "engine",
                        "controllers",
                        "providers",
                        "agents"
                    ]
                ]
            },
            {
                "layer": [
                    "features",
                    [
                        "resources",
                        "engine",
                        "controllers",
                        "providers",
                        "agents",
                        "supervisor",
                        "overview"
                    ]
                ]
            },
            {
                "layer": [
                    "migrations",
                    [
                        "resources",
                        "engine",
                        "controllers",
                        "providers",
                        "features",
                        "overview"
                    ]
                ]
            },
            {
                "layer": [
                    "surfaces",
                    [
                        "resources",
                        "engine",
                        "controllers",
                        "providers",
                        "agents",
                        "features",
                        "overview"
                    ]
                ]
            },
            {
                "layer": [
                    "commands",
                    [
                        "resources",
                        "engine",
                        "controllers",
                        "providers",
                        "agents",
                        "runner",
                        "features",
                        "migrations",
                        "surfaces",
                        "install",
                        "skills",
                        "serve",
                        "overview"
                    ]
                ]
            },
            {
                "layer": [
                    "skills",
                    [
                        "resources",
