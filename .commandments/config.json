{
    "$schema": "./config.schema.json",
    "paths": [
        "src"
    ],
    "exclude": [
        ".venv",
        "__pycache__"
    ],
    "disable": {
        "languages": [
            "php",
            "typescript",
            "csharp"
        ]
    },
    "configure": {
        "frontend/ComponentBudgetDetector": [
            {
                "elements": [
                    50
                ]
            }
        ]
    }
}
