{
    "$schema": "./config.schema.json",
    "paths": [
        "src/core",
        "tests"
    ],
    "base": "main",
    "disable": {
        "languages": [
            "php",
            "csharp",
            "typescript",
            "go"
        ]
    },
    "detectors": [
        "PlainViewerTextDetector",
        "PlainServerTextDetector",
        "PlainJournalTextDetector",
        "PlainViewerScriptTextDetector",
        "PlainViewerPageTextDetector",
        "SentenceLabelDetector",
        "SentenceLabelScriptDetector",
        "PoeticTypeNameDetector",
        "SentenceTypeNameDetector",
        "PoeticMethodNameDetector",
        "SentenceMethodNameDetector",
        "SentenceVariableNameDetector",
        "SentenceParameterNameDetector",
        "PoeticVariableNameDetector",
        "PoeticParameterNameDetector",
        "UnitlessQuantityNameDetector",
        "LongDocstringLineDetector",
        "PlainSettingsGroupTitleDetector",
        "PlainSettingsTabTitleDetector",
        "SqlOutsideDatabaseLayerDetector"
    ],
    "parallel": 2,
    "configure": {
        "python/NamespaceDependencyDetector": [
            {
                "layer": [
                    "core.base"
                ]
            },
            {
                "layer": [
                    "core.modules.actors",
                    [
                        "core.base"
                    ]
                ]
            },
            {
                "layer": [
                    "core.modules.environments",
                    [
                        "core.base",
                        "core.modules.actors"
                    ]
                ]
            },
            {
                "layer": [
                    "core.modules.agents",
                    [
                        "core.base",
                        "core.modules.actors",
                        "core.modules.environments"
                    ]
                ]
            },
            {
                "layer": [
                    "core.modules.tasks",
                    [
                        "core.base",
                        "core.modules.actors",
                        "core.modules.environments",
                        "core.modules.agents"
                    ]
                ]
            },
            {
                "layer": [
                    "core.modules.plans",
                    [
                        "core.base",
                        "core.modules.actors",
                        "core.modules.environments",
                        "core.modules.agents",
                        "core.modules.tasks"
                    ]
                ]
            },
            {
                "layer": [
                    "core.modules.messages",
                    [
                        "core.base",
                        "core.modules.actors",
                        "core.modules.environments",
                        "core.modules.agents"
                    ]
                ]
            },
            {
                "layer": [
                    "core.modules.settings",
                    [
                        "core.base",
                        "core.modules.actors"
                    ]
                ]
            },
            {
                "layer": [
                    "core.journal_module",
                    [
                        "core.base",
                        "core.modules.actors",
                        "core.modules.settings"
                    ]
                ]
            },
            {
                "layer": [
                    "core.journal",
                    [
                        "core.base"
                    ]
                ]
            }
        ],
        "vue/ComponentBudgetDetector": [
            {
                "elements": [
                    50
                ]
            }
        ],
        "PoeticTypeNameDetector": [
            {
                "judges": [
                    "tests"
                ]
            }
        ],
        "PoeticMethodNameDetector": [
            {
                "judges": [
                    "tests"
                ]
            }
        ],
        "PoeticVariableNameDetector": [
            {
                "judges": [
                    "tests"
                ]
            }
        ],
        "PoeticParameterNameDetector": [
            {
                "judges": [
                    "tests"
                ]
            }
        ],
        "LongDocstringLineDetector": [
            {
                "judges": [
                    "tests"
                ]
            }
        ]
    },
    "exclude": [
        "tests"
    ]
}
