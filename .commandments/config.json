                        "providers",
                        "features",
                        "overview"
                    ]
                ]
            },
            {
                "layer": [
                    "install",
                    [
                        "resources",
                        "engine",
                        "controllers",
                        "providers",
                        "features",
                        "migrations",
                        "commands",
                        "skills",
                        "overview"
                    ]
                ]
            },
            {
                "layer": [
                    "serve",
                    [
                        "resources",
