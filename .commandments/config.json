{
    "$schema": "./config.schema.json",
    "paths": [
        "app",
        "resources/js"
    ],
    "exclude": [
        "**/bootstrap/cache",
        "**/node_modules",
        "**/public/build",
        "**/storage",
        "**/vendor"
    ],
    "disable": {
        "languages": [
            "python",
            "csharp",
            "go"
        ]
    },
    "detectors": [
        "ModelCastsBelowAttributesDetector"
    ],
    "parallel": 2,
    "read_at_once": 1,
    "cache_hours": 12
}
