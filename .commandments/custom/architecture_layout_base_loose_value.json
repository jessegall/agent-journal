{
    "$schema": "../rule.schema.json",
    "engine": "python",
    "find": {
        "select": "assignment",
        "where": [
            {
                "topLevel": true
            },
            {
                "fileMatches": "^(\\.commandments/custom/samples/layout/)?src/(core/base|engine)/[^/]+\\.py$"
            }
        ],
        "reject": [
            {
                "fileMatches": "(^|/)__init__\\.py$"
            },
            {
                "testCode": true
            },
            {
                "file": "src/core/base/agent_roster.py"
            },
            {
                "file": "src/core/base/code_copy.py"
            },
            {
                "file": "src/core/base/code_versions.py"
            },
            {
                "file": "src/core/base/conflict_files.py"
            },
            {
                "file": "src/core/base/connection_probe.py"
            },
            {
                "file": "src/core/base/container.py"
            },
            {
                "file": "src/core/base/exception_sink.py"
            },
            {
                "file": "src/core/base/file_access.py"
            },
            {
                "file": "src/core/base/file_fingerprints.py"
            },
            {
                "file": "src/core/base/file_version.py"
            },
            {
                "file": "src/core/base/helper_type_book.py"
            },
            {
                "file": "src/core/base/instruction_imports.py"
            },
            {
                "file": "src/core/base/internet_connection.py"
            },
            {
                "file": "src/core/base/journal.py"
            },
            {
                "file": "src/core/base/journal_home.py"
            },
            {
                "file": "src/core/base/journal_version.py"
            },
            {
                "file": "src/core/base/leftover_process.py"
            },
            {
                "file": "src/core/base/plugin_script_process.py"
            },
            {
                "file": "src/core/base/plugin_script_processes.py"
            },
            {
                "file": "src/core/base/request_values.py"
            },
            {
                "file": "src/core/base/server_restart_state.py"
            },
            {
                "file": "src/core/base/system_log_writer.py"
            },
            {
                "file": "src/core/base/timestamp.py"
            },
            {
                "file": "src/core/base/timing.py"
            },
            {
                "file": "src/core/base/timing_log.py"
            },
            {
                "file": "src/core/base/version.py"
            }
        ]
    },
    "sin": {
        "name": "base-loose-value",
        "description": "A value sits loose directly in the engine folder, so it belongs to no folder.",
        "rule": "Move it into the folder of its area under the engine folder. Every class, function and value sits in a folder named for its sort: errors, enums, models, support or the folder of its area.",
        "skill": "plain-code-words"
    }
}
