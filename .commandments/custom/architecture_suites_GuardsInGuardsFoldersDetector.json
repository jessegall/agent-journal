{
    "$schema": "../rule.schema.json",
    "engine": "python",
    "find": {
        "select": "type-declaration",
        "where": [
            {
                "fileMatches": "(^|/)src/suites/"
            },
            {
                "any": [
                    {
                        "extendsAny": "Guard"
                    }
                ]
            }
        ],
        "reject": [
            {
                "fileMatches": "(^|/)src/suites/[^/]+/(drivers/[^/]+/|modules/[^/]+/)?guards/[^/]+\\.py$"
            },
            {
                "testCode": true
            }
        ]
    },
    "sin": {
        "name": "suite-guard-outside-guards",
        "description": "A suite's guard sits outside a guards folder.",
        "rule": "A guard one driver uses lives in src/suites/<suite>/drivers/<driver>/guards/; a guard for every driver lives in src/suites/<suite>/guards/.",
        "skill": "plain-code-words"
    }
}
