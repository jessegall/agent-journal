{
    "$schema": "../rule.schema.json",
    "engine": "python",
    "find": {
        "select": "type-declaration",
        "where": [
            {
                "fileMatches": "(^|/)src/suites/"
            },
            {
                "any": [
                    {
                        "extendsAny": "SaveListener"
                    },
                    {
                        "extendsAny": "CommitListener"
                    },
                    {
                        "extendsAny": "DeletionListener"
                    }
                ]
            }
        ],
        "reject": [
            {
                "fileMatches": "(^|/)src/suites/[^/]+/(drivers/[^/]+/|modules/[^/]+/)?listeners/[^/]+\\.py$"
            },
            {
                "testCode": true
            }
        ]
    },
    "sin": {
        "name": "suite-listener-outside-listeners",
        "description": "A suite's listener sits outside a listeners folder.",
        "rule": "A suite's listeners live in its listeners folder: src/suites/<suite>/listeners/, beneath a driver for one driver's, or in its module's.",
        "skill": "plain-code-words"
    }
}
