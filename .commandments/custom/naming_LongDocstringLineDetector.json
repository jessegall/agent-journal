{
    "$schema": "../rule.schema.json",
    "engine": "python",
    "find": {
        "select": "literal",
        "where": [
            {
                "is": "expression-statement",
                "of": "parent"
            },
            {
                "inside": {
                    "is": "type-declaration"
                }
            },
            {
                "textMatches": "(?m)^.{111,}$"
            }
        ],
        "reject": [
            {
                "inside": {
                    "is": "function"
                }
            }
        ]
    },
    "sin": {
        "name": "long-docstring-line",
        "description": "A line of a class's docstring runs past 110 characters, so it reads as one long line off the edge of the screen.",
        "rule": "Wrap the docstring onto new lines of at most 110 characters each, indented with the class body.",
        "skill": "plain-code-words"
    }
}
