{
    "$schema": "../rule.schema.json",
    "engine": "python",
    "find": {
        "select": "assignment",
        "where": [
            {
                "fileMatches": "_(module|suite)\\.py$"
            },
            {
                "inside": {
                    "is": "type-declaration"
                }
            },
            {
                "not": {
                    "inside": {
                        "is": "function"
                    }
                }
            },
            {
                "descendant": {
                    "all": [
                        {
                            "any": [
                                {
                                    "field": "elts"
                                },
                                {
                                    "field": "keys"
                                },
                                {
                                    "field": "values"
                                }
                            ]
                        },
                        {
                            "any": [
                                {
                                    "is": "call"
                                },
                                {
                                    "is": "literal"
                                },
                                {
                                    "kind": "Tuple"
                                }
                            ]
                        },
                        {
                            "not": {
                                "all": [
                                    {
                                        "name": "ModelDeclaration"
                                    },
                                    {
                                        "arguments": {
                                            "atMost": 1
                                        }
                                    }
                                ]
                            }
                        }
                    ]
                }
            }
        ],
        "reject": [
            {
                "testCode": true
            },
            {
                "child": {
                    "field": "targets",
                    "nameIn": [
                        "dependencies",
                        "file_events",
                        "declared_plugin_events",
                        "former_event_keys"
                    ]
                }
            },
            {
                "fileMatches": "/migrations/"
            },
            {
                "all": [
                    {
                        "fileMatches": ".commandments/custom/samples/"
                    },
                    {
                        "not": {
                            "fileMatches": ".commandments/custom/samples/declarations/"
                        }
                    }
                ]
            }
        ]
    },
    "sin": {
        "name": "list-entry-not-a-class",
        "description": "A module or suite attribute lists a call, a literal or a tuple instead of the names of classes.",
        "rule": "A module lists class names: make each entry a class in its own file and list that class. A short ModelDeclaration(Model) with no other argument stays; dependencies name other modules by their keys, and file_events, declared_plugin_events and former_event_keys name events by their keys. docs/writing-a-module.md shows the form.",
        "skill": "module-registration"
    }
}
