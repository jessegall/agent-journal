{
    "$schema": "commandments:neutral-rule/v2",
    "engine": "php",
    "sin": {
        "description": "A line of PHP code wider than 120 characters.",
        "name": "line-too-wide",
        "rule": "No PHP line goes past 120 characters: break a long call one argument per line, or name its argument first (rule 38). A line that carries one message, a string of 60 characters or more, stays one line (user question 28), and a console $signature stays one line because Laravel reads its options only within one line.",
        "skill": "line-width"
    },
    "find": {
        "select": [
            "statement",
            "expression",
            "declaration",
            "parameter",
            "argument",
            "entry",
            "attribute"
        ],
        "as": "n",
        "where": [
            "and",
            [
                "=",
                [
                    "lineCount",
                    "$n"
                ],
                1
            ],
            [
                ">",
                [
                    "width",
                    "$n"
                ],
                120
            ],
            [
                "or",
                [
                    "not",
                    [
                        "exists",
                        "$n.parent"
                    ]
                ],
                [
                    ">",
                    [
                        "lineCount",
                        "$n.parent"
                    ],
                    1
                ]
            ],
            [
                "matchesText",
                "$n.file.path",
                "(^|/)(app|domain|tests|config|\\.commandments/custom/samples)/"
            ],
            [
                "not",
                [
                    "some",
                    [
                        "append",
                        [
                            "list",
                            "$n"
                        ],
                        [
                            "descendants",
                            [
                                "coalesce",
                                [
                                    "enclosing",
                                    "$n",
                                    "statement"
                                ],
                                "$n"
                            ]
                        ]
                    ],
                    "l",
                    [
                        "and",
                        [
                            "in",
                            "$l.kind",
                            "literal",
                            "interpolation"
                        ],
                        [
                            "=",
                            "$l.line",
                            "$n.line"
                        ],
                        [
                            ">=",
                            [
                                "length",
                                [
                                    "text",
                                    [
                                        "coalesce",
                                        [
                                            "constant",
                                            "$l"
                                        ],
                                        "$l.text",
                                        ""
                                    ]
                                ]
                            ],
                            60
                        ]
                    ]
                ]
            ],
            [
                "not",
                [
                    "some",
                    [
                        "append",
                        [
                            "list",
                            "$n"
                        ],
                        [
                            "ancestors",
                            "$n"
                        ]
                    ],
                    "a",
                    [
                        "and",
                        [
                            "is",
                            "$a",
                            "field"
                        ],
                        [
                            "some",
                            "$a.declarators",
                            "d",
                            [
                                "=",
                                "$d.binding.name",
                                "signature"
                            ]
                        ]
                    ]
                ]
            ]
        ],
        "emit": "$n"
    }
}
