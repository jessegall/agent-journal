{
    "$schema": "../rule.schema.json",
    "engine": "python",
    "find": {
        "select": "kind:comprehension",
        "where": [
            {
                "count": {
                    "child": {
                        "lines": {
                            "atLeast": 1
                        }
                    },
                    "field": "ifs",
                    "atLeast": 1
                }
            },
            {
                "of": "child:iter",
                "kind": "Call"
            },
            {
                "of": "child:iter",
                "all": [
                    {
                        "of": "child:func",
                        "all": [
                            {
                                "of": "child:value",
                                "all": [
                                    {
                                        "nameIn": [
                                            "agents",
                                            "aliases",
                                            "checks",
                                            "codes",
                                            "collections",
                                            "command_outputs",
                                            "dashboard_rows",
                                            "doc_revisions",
                                            "docs",
                                            "dumps",
                                            "edits",
                                            "entries",
                                            "environments",
                                            "facts",
                                            "journal_versions",
                                            "links",
                                            "logs",
                                            "mcp_servers",
                                            "messages",
                                            "notices",
                                            "outputs",
                                            "phone_codes",
                                            "phones",
                                            "plan_reviews",
                                            "plans",
                                            "plugins",
                                            "proofs",
                                            "questions",
                                            "reactions",
                                            "reminders",
                                            "reports",
                                            "reviews",
                                            "revisions",
                                            "rows",
                                            "rules",
                                            "secrets",
                                            "sequences",
                                            "servers",
                                            "settings",
                                            "shares",
                                            "statistics",
                                            "subagents",
                                            "suggestions",
                                            "task_logs",
                                            "tasks",
                                            "templates",
                                            "timings",
                                            "todos",
                                            "triggers",
                                            "users",
                                            "versions",
                                            "worker_todos",
                                            "workers"
                                        ]
                                    },
                                    {
                                        "of": "child:value",
                                        "is": "self-reference"
                                    }
                                ]
                            }
                        ]
                    }
                ]
            }
        ],
        "reject": [
            {
                "count": {
                    "child": {
                        "kind": "NamedExpr"
                    },
                    "field": "ifs",
                    "atLeast": 1
                }
            },
            {
                "file": "src/journal/repositories/**"
            },
            {
                "file": "src/journal/db/**"
            },
            {
                "testCode": true
            }
        ]
    },
    "sin": {
        "name": "row-filter-outside-repository",
        "description": "Rows a repository returned are filtered after it: the choice of which rows, by their state, kind, session or another field, is made by the caller, so the rule is written wherever it is needed and drifts apart.",
        "rule": "Ask the repository for exactly the rows wanted with a method named for them, such as Tasks.open_tasks() or Workers.running_workers(), composed with Query, and call that everywhere the choice is needed.",
        "skill": "rows-through-their-repository"
    }
}
