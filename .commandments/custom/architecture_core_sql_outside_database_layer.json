{
    "$schema": "../rule.schema.json",
    "engine": "python",
    "find": {
        "select": "literal",
        "where": [
            {
                "any": [
                    {"textMatches": "(^\\s*(SELECT|INSERT|UPDATE|DELETE|CREATE|DROP|ALTER|WITH)\\s|\\(\\s*SELECT\\s)"},
                    {"of": "parent", "all": [{"is": "call"}, {"name": "Statement"}]}
                ]
            }
        ],
        "reject": [
            {
                "fileMatches": "(^|/)engine/(database|query)/"
            },
            {
                "fileMatches": "(^|/)migrations/"
            },
            {
                "fileMatches": "(^|/)conditions/"
            },
            {
                "all": [
                    {"fileMatches": "(^|/)views\\.py$"},
                    {"not": {"inside": {"is": "function"}}}
                ]
            },
            {
                "testCode": true
            }
        ]
    },
    "sin": {
        "name": "sql-outside-database-layer",
        "description": "SQL text is written outside base/database, base/query, a migration, a module's views.py or its conditions, so its table and column names go unchecked.",
        "rule": "Name the statement in the database layer (base/database) or build it with the query builder, and use it from there. A views.py function only joins named statements: the SQL text itself stands as a top-level constant of the file.",
        "skill": "sql-in-the-database-layer"
    }
}
