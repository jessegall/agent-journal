{
    "$schema": "../rule.schema.json",
    "engine": "python",
    "find": {
        "select": "call",
        "where": [
            {
                "name": "Reader"
            },
            {
                "of": "parent",
                "name": "save"
            }
        ],
        "reject": [
            {
                "testCode": true
            },
            {
                "fileMatches": "/(add_reader_handler|reader_file)\\.py$|/migrations/"
            }
        ]
    },
    "sin": {
        "name": "reader-saved-outside-add-reader",
        "description": "A reader is saved outside its writer check and output proof.",
        "rule": "Save reader definitions through AddReader. A reader built only to judge a command is a value, not a saved definition.",
        "skill": "processes-architecture"
    }
}
