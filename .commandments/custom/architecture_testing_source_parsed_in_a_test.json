{
    "$schema": "../rule.schema.json",
    "engine": "python",
    "find": {
        "select": "call",
        "where": [
            {
                "name": "parse"
            },
            {
                "of": "child:func",
                "descendant": {
                    "name": "ast"
                }
            },
            {
                "fileMatches": "(^|/)tests/"
            }
        ],
        "reject": [
            {
                "fileMatches": "(^|/)tests/unit/source_tree\\.py$"
            },
            {
                "fileMatches": "(^|/)tests/stories/core/modules/agents/dispatcher_rules\\.py$"
            }
        ]
    },
    "sin": {
        "name": "source-parsed-in-a-test",
        "description": "A test parses source files itself, so each test parses them again.",
        "rule": "Use source_tree from tests/unit/source_tree.py, which parses each file once per test process.",
        "skill": "plain-code-words"
    }
}
