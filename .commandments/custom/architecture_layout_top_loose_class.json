{
    "$schema": "../rule.schema.json",
    "engine": "python",
    "find": {
        "select": "type-declaration",
        "where": [
            {
                "fileMatches": "^(\\.commandments/custom/samples/layout/)?src/(core|server|install|tunnels)/[^/]+\\.py$"
            }
        ],
        "reject": [
            {
                "fileMatches": "(^|/)(__init__|[a-z_]+_(module|suite))\\.py$"
            },
            {
                "testCode": true
            },
            {
                "file": "src/install/backup_result.py"
            },
            {
                "file": "src/install/built_bundle.py"
            },
            {
                "file": "src/install/built_bundles.py"
            },
            {
                "file": "src/install/chat_update_steps.py"
            },
            {
                "file": "src/install/code_replacement.py"
            },
            {
                "file": "src/install/hook_switch.py"
            },
            {
                "file": "src/install/hook_writer.py"
            },
            {
                "file": "src/install/install_journal.py"
            },
            {
                "file": "src/install/restore_version_four.py"
            },
            {
                "file": "src/install/run_drain.py"
            },
            {
                "file": "src/install/server_lock.py"
            },
            {
                "file": "src/install/server_stop.py"
            },
            {
                "file": "src/install/upgrade_journal.py"
            },
            {
                "file": "src/install/upgrade_outcome.py"
            },
            {
                "file": "src/install/upgrade_report_file.py"
            },
            {
                "file": "src/install/upgrade_text.py"
            },
            {
                "file": "src/install/version_four.py"
            },
            {
                "file": "src/install/version_four_backup.py"
            },
            {
                "file": "src/install/version_four_files.py"
            },
            {
                "file": "src/install/working_tree_install.py"
            },
            {
                "file": "src/server/code_folders.py"
            },
            {
                "file": "src/server/code_version.py"
            },
            {
                "file": "src/server/handover_descriptors.py"
            },
            {
                "file": "src/server/server_backup.py"
            },
            {
                "file": "src/server/server_plugin_services.py"
            },
            {
                "file": "src/server/server_tunnel.py"
            },
            {
                "file": "src/server/successor_proof.py"
            },
            {
                "file": "src/server/successor_start.py"
            },
            {
                "file": "src/server/tick_handler_work.py"
            },
            {
                "file": "src/server/ticker.py"
            },
            {
                "file": "src/server/waiting_server.py"
            }
        ]
    },
    "sin": {
        "name": "top-loose-class",
        "description": "A class sits loose directly in a top folder of src, so it belongs to no folder.",
        "rule": "Move it into the folder of its area under a top folder of src. Every class, function and value sits in a folder named for its sort: errors, enums, models, support or the folder of its area.",
        "skill": "plain-code-words"
    }
}
