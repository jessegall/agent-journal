{
    "$schema": "../rule.schema.json",
    "engine": "python",
    "find": {
        "select": "type-declaration",
        "where": [
            {
                "fileMatches": "(^|/)src/(suites|core/modules)/"
            },
            {
                "any": [
                    {
                        "extendsAny": "Command"
                    },
                    {
                        "extendsAny": "Handler"
                    },
                    {
                        "extendsAny": "Subcommand"
                    },
                    {
                        "extendsAny": "ReadSubcommand"
                    }
                ]
            }
        ],
        "reject": [
            {
                "fileMatches": "(^|/)src/(suites|core/modules)/[^/]+/(modules/[^/]+/)?commands/[^/]+\\.py$"
            },
            {
                "testCode": true
            }
        ]
    },
    "sin": {
        "name": "suite-command-outside-commands",
        "description": "A suite's or module's command, handler or subcommand sits outside a commands folder.",
        "rule": "A suite's or module's commands live in its commands folder, each beside its handler and its subcommand: src/suites/<suite>/commands/ or src/suites/<suite>/modules/<module>/commands/.",
        "skill": "plain-code-words"
    }
}
