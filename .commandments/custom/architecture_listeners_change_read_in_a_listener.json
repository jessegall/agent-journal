{
    "$schema": "../rule.schema.json",
    "engine": "python",
    "find": {
        "select": "member-access",
        "where": [
            {
                "of": "child:var",
                "typeLike": "*Change"
            },
            {
                "fileMatches": "(^|/)src/(core/modules|suites)/.+/(listeners|guards)/[^/]+\\.py$"
            }
        ],
        "reject": [
            {
                "testCode": true
            }
        ]
    },
    "sin": {
        "name": "change-read-in-a-listener",
        "description": "A listener or guard reads a Change, the shape of the old listeners.",
        "rule": "Take the typed event: event.row, event.old_row and event.move, with the context beside it.",
        "skill": "plain-code-words"
    }
}
