{
    "$schema": "../rule.schema.json",
    "engine": "python",
    "sin": {
        "name": "command-in-a-nudge",
        "description": "A nudge's text tells the agent which journal command to run.",
        "rule": "Name the row, its number and what happened, nothing more. The agent knows the commands from its skills, so a nudge never repeats one.",
        "skill": "plain-code-words"
    },
    "find": {
        "select": "call",
        "where": [
            {
                "of": "child:func",
                "resolvesLike": "core.base.driver.nudge_declaration.NudgeDeclaration"
            },
            {
                "any": [
                    {
                        "argument": {
                            "at": 2,
                            "textMatches": "\\bjournal (${journal_command_nouns})\\b"
                        }
                    },
                    {
                        "descendant": {
                            "all": [
                                {
                                    "is": "literal"
                                },
                                {
                                    "inside": {
                                        "nameIn": [
                                            "text",
                                            "plural_text"
                                        ]
                                    }
                                },
                                {
                                    "textMatches": "\\bjournal (${journal_command_nouns})\\b"
                                }
                            ]
                        }
                    }
                ]
            }
        ],
        "reject": [
            {
                "testCode": true
            }
        ]
    }
}
