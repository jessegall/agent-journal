{
    "$schema": "../rule.schema.json",
    "engine": "php",
    "find": {
        "select": "construction",
        "where": [
            {
                "of": "child:class",
                "extendsAny": "Spatie\\LaravelData\\Data"
            },
            {
                "count": {
                    "descendant": {
                        "all": [
                            {
                                "kind": "Expr_PropertyFetch"
                            },
                            {
                                "of": "receiver",
                                "isA": "Illuminate\\Database\\Eloquent\\Model"
                            }
                        ]
                    },
                    "atLeast": 2
                }
            }
        ],
        "reject": [
            {
                "php": "inDataClass"
            },
            {
                "testCode": true
            }
        ]
    },
    "sin": {
        "description": "A Data object constructed argument by argument from a model's own values, at the place that holds the model.",
        "name": "data-built-from-model-fields",
        "rule": "Hand the model itself to the Data class, DockSuggestion::from($this), and let a from<Model> factory on the Data class say once how that model becomes it (user message 13565).",
        "skill": "php/spatie-data-hydration"
    }
}
