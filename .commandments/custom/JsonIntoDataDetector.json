{
    "$schema": "../rule.schema.json",
    "engine": "php",
    "find": {
        "select": "kind:Expr_FuncCall",
        "where": [
            {
                "name": "json_decode"
            }
        ],
        "reject": [
            {
                "file": "app/Files/**"
            },
            {
                "file": "tests/**"
            },
            {
                "of": "closest:call",
                "all": [
                    {
                        "nameIn": [
                            "from",
                            "collect",
                            "validateAndCreate"
                        ]
                    },
                    {
                        "of": "child:class",
                        "extendsAny": "Spatie\\LaravelData\\Data"
                    }
                ]
            },
            {
                "inside": {
                    "hasAnnotation": "App\\Settings\\Attributes\\DecodesAnyJson"
                }
            }
        ]
    },
    "sin": {
        "description": "Decoded JSON is read as a loose array instead of a Data class that writes its shape down.",
        "name": "json-into-data",
        "rule": "Hand json_decode's result straight to a Spatie Data class's from(), collect() or validateAndCreate() and read its typed properties, never $decoded['key'] ?? fallback. A method decoding JSON of no fixed shape (a value of any JSON type kept as stored) carries #[DecodesAnyJson], allowed only where JsonIntoDataTest lists it.",
        "skill": "php/spatie-data"
    }
}
