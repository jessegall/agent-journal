{
    "$schema": "../rule.schema.json",
    "engine": "go",
    "find": {
        "select": "literal",
        "where": [
            {
                "any": [
                    {
                        "of": "parent",
                        "kind": "CaseClause"
                    },
                    {
                        "of": "parent",
                        "is": "comparison"
                    }
                ]
            },
            {
                "textMatches": "^(claude|codex)$"
            }
        ],
        "reject": [
            {
                "testCode": true
            },
            {
                "file": "**/journal-hook/programs/**"
            }
        ]
    },
    "sin": {
        "name": "go-program-switch-outside-programs",
        "description": "Go code outside the programs package switches on or compares an agent program's name, so a third program means editing every place.",
        "rule": "Ask the program's row in the program table, or its decoder in tools/journal-hook/programs, for what differs between programs.",
        "skill": "plain-code-words"
    }
}
