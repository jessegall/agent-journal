{
    "$schema": "../rule.schema.json",
    "engine": "python",
    "find": {
        "select": "call",
        "where": [
            {
                "of": "child:func",
                "resolvesLike": "engine.driver.message_template.MessageTemplate"
            },
            {
                "argument": {
                    "at": 2,
                    "textMatches": "\\{(line|command|title|text|lines)\\}"
                }
            },
            {
                "fileMatches": "(^|/)core/modules/(processes/support/process_agent_messages|aliases/support/alias_agent_messages)\\.py$"
            }
        ],
        "reject": [
            {
                "testCode": true
            },
            {
                "argument": {
                    "at": 2,
                    "textMatches": "\\{lines\\} lines|of \\{lines\\}"
                }
            }
        ]
    },
    "sin": {
        "name": "agent-message-carries-row-data",
        "description": "An agent message declaration puts a command, a title, a line or a text of a stored row into the line an agent receives.",
        "rule": "An agent message names the row and its number; the agent reads the rest by command (rule 8).",
        "skill": "processes-architecture"
    }
}
