{
    "$schema": "../rule.schema.json",
    "engine": "python",
    "find": {
        "select": "call",
        "where": [
            {
                "any": [
                    {
                        "all": [
                            {
                                "nameIn": [
                                    "run",
                                    "Popen",
                                    "call",
                                    "check_call",
                                    "check_output"
                                ]
                            },
                            {
                                "descendant": {
                                    "all": [
                                        {
                                            "is": "identifier"
                                        },
                                        {
                                            "resolves": "subprocess"
                                        }
                                    ]
                                }
                            },
                            {
                                "not": {
                                    "descendant": {
                                        "all": [
                                            {
                                                "kind": "keyword"
                                            },
                                            {
                                                "name": "timeout"
                                            }
                                        ]
                                    }
                                }
                            }
                        ]
                    },
                    {
                        "all": [
                            {
                                "name": "ExecutionRequest"
                            },
                            {
                                "any": [
                                    {
                                        "argument": {
                                            "at": 2,
                                            "all": [
                                                {
                                                    "is": "member-access"
                                                },
                                                {
                                                    "name": "QUICK"
                                                }
                                            ]
                                        }
                                    },
                                    {
                                        "argument": {
                                            "at": 3,
                                            "value": 0
                                        }
                                    },
                                    {
                                        "argument": {
                                            "at": 3,
                                            "value": null
                                        }
                                    }
                                ]
                            }
                        ]
                    }
                ]
            },
            {
                "inside": {
                    "all": [
                        {
                            "is": "type-declaration"
                        },
                        {
                            "name": "WorktreeGit"
                        }
                    ]
                }
            }
        ],
        "reject": [
            {
                "testCode": true
            }
        ]
    },
    "sin": {
        "name": "git-call-without-time-limit",
        "description": "A git call in WorktreeGit has no hard time limit: a subprocess call without timeout=, or a run through the door of the quick kind, which waits on past its limit, or with no limit at all, so a hung git holds the dispatch or the merge, and its transaction.",
        "rule": "Pass timeout= on every subprocess call in WorktreeGit, and give every ExecutionRequest of WorktreeGit a kind that stops at its limit (READ for a read, MERGE for a branch change) and its GIT_LIMIT_SECONDS or CHECKOUT_LIMIT_SECONDS.",
        "skill": "workers-architecture"
    }
}
