{
    "$schema": "../rule.schema.json",
    "engine": "python",
    "find": {
        "select": "parameter",
        "where": [
            {
                "nameMatches": "^(said|worded|meaning|whisper|whispered|murmur|mutter|muse|mused|spoken|spoke|telling|told|utter|uttered|stay|stayed|dwell|linger|tarry|made|done|seen|taken|heard|noted|got|met|gone|lost|borne|wrought|bestowed|beheld|thing|things|stuff|foo|bar|baz|tmp|temp|misc|obj|val|res|ret|blob|dummy|junk|whatever|bunch|lot|result|info|element|object|chunk|bits|magic|gist|essence|soul|spirit|heart|tale|story|lore|saga|legend|myth|fable|echo|hush|mood|vibe|wish|hope|fear|worry|joy|bliss|blessed|curse|cursed|doom|fate|destiny|luck|charm|spell|ghost|phantom|dawn|dusk|twilight|journey|voyage|quest|realm|kingdom|hero|beast|whim|fancy|dream|glimpse|snapshot|stance|posture|footing|bearing|look|looked|gazed|noticed|spotted|caught|grasped|felt|sensed|knew|learned|remembered|forgot|forgotten|recalled|went|came|fell|rose|stood|sat|lay|awoke|woke|wandered|strayed|drifted|readings|reading|picture|impression|sense|feel|notion|outlook|landscape|terrain|scene|backdrop|climate|weather|tide|wave|footprint|shadow|mirror|pulse|breath|temper|flavour|taste|scent|shade|hue|spot|catch|offer|owe|owed|pay|paid|carry|carried|land|landed|settle|settled|sweep|swept|tidy|cope|deal|hush|born|birth|heal|say|says|held|hold|holds|holding|named|back|forth)$"
            }
        ]
    },
    "sin": {
        "name": "poetic-parameter-name",
        "description": "A parameter is named by a word that does not say what it is: said, whisper, tale, magic, made, thing, stuff, got, done.",
        "rule": "Name a parameter for what it holds, in an ordinary word: nudge, line, values.",
        "skill": "plain-code-words"
    }
}
