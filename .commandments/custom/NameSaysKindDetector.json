{
    "$schema": "commandments:neutral-rule/v2",
    "engine": "php",
    "sin": {
        "description": "A name says Kind where the project says Type for a category of things.",
        "name": "name-says-kind",
        "rule": "Name a category of things with Type, never Kind (rule 22): ActorType, StateType, $type.",
        "skill": "name-says-kind"
    },
    "find": {
        "select": [
            "type",
            "function",
            "enum-case",
            "binding",
            "reference"
        ],
        "as": "d",
        "where": [
            "matchesText",
            [
                "coalesce",
                "$d.name",
                ""
            ],
            "Kind|(^|_)(?i:kind)"
        ],
        "emit": "$d"
    }
}
