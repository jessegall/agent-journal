{
    "$schema": "../rule.schema.json",
    "engine": "python",
    "find": {
        "select": "member-access",
        "where": [
            {
                "name": "executable"
            },
            {
                "of": "child:value",
                "name": "sys"
            },
            {
                "fileMatches": "(^|/)tests/(stories|unit|install)/"
            }
        ],
        "reject": [
            {
                "fileMatches": "(^|/)tests/(stories/engine/upgrade/support/released_journal|stories/server/support/server_process|stories/server/handover|stories/server/look_at_screen|stories/engine/testing/templates/shared_templates|stories/engine/testing/runs/heavy_run_gate|stories/core/modules/plugins/plugin_calls|stories/core/modules/plugins/checkouts|stories/core/modules/plugins/skills|stories/core/modules/plugins/event_guard|stories/core/modules/plugins/support/worktree_plugin|stories/core/modules/plugins/support/runner_binaries|stories/core/modules/aliases/shared_tests|stories/suites/coding/modules/workers/worktree_events|stories/suites/coding/modules/workers/folder_removal|unit/engine/testing/templates/test_temp_folders|unit/engine/testing/templates/test_template_cache|unit/engine/cli/test_entry_point|unit/server/test_server_files)\\.py$"
            },
            {
                "fileMatches": "(^|/)tests/stories/suites/coding/modules/workers/support/judge_plugin\\.py$"
            }
        ]
    },
    "sin": {
        "name": "interpreter-in-a-test",
        "description": "A story or a unit test starts a fresh Python interpreter, which costs far more than the test around it.",
        "rule": "Run the code in the test's own process. A test whose subject is a real process belongs in tests/install, or is named in this rule with that reason.",
        "skill": "plain-code-words"
    }
}
