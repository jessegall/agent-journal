{
    "$schema": "commandments:neutral-rule/v2",
    "engine": "php",
    "sin": {
        "description": "A method builds a whole out of parts it constructs itself, three or more of the project's own objects put together in place.",
        "name": "inline-composition",
        "rule": "Give the whole a class of its own, constructed with what it needs (new DocumentDockCard($this, $context)), which composes its own parts; the method only hands over to it (user messages 13568 and 13571).",
        "skill": "php/value-objects"
    },
    "find": {
        "select": "function",
        "as": "f",
        "where": [
            "and",
            [
                "=",
                "$f.form",
                "method"
            ],
            [
                "not",
                "$f.file.test"
            ],
            [
                "not",
                [
                    "has",
                    [
                        "functionRole",
                        "$f"
                    ],
                    "named-constructor"
                ]
            ],
            [
                ">=",
                [
                    "count",
                    [
                        "filter",
                        [
                            "descendants",
                            "$f",
                            "construction"
                        ],
                        "n",
                        [
                            "matchesText",
                            [
                                "coalesce",
                                [
                                    "symbolOf",
                                    "$n"
                                ],
                                ""
                            ],
                            "^(App|Domain)\\\\"
                        ]
                    ]
                ],
                3
            ],
            [
                "some",
                [
                    "descendants",
                    "$f",
                    "return"
                ],
                "r",
                [
                    "some",
                    "$r.values",
                    "v",
                    [
                        "or",
                        [
                            "is",
                            "$v",
                            "construction"
                        ],
                        [
                            "and",
                            [
                                "is",
                                "$v",
                                "call"
                            ],
                            [
                                "=",
                                "$v.callee.form",
                                "static"
                            ]
                        ]
                    ]
                ]
            ]
        ],
        "emit": "$f"
    }
}
