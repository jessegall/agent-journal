{
    "$schema": "../rule.schema.json",
    "engine": "python",
    "find": {
        "select": "call",
        "where": [
            {
                "fileMatches": "_(module|suite)\\.py$"
            },
            {
                "field": "elts"
            },
            {
                "inside": {
                    "is": "type-declaration"
                }
            },
            {
                "not": {
                    "inside": {
                        "is": "function"
                    }
                }
            }
        ],
        "reject": [
            {
                "testCode": true
            },
            {
                "all": [
                    {
                        "name": "ModelDeclaration"
                    },
                    {
                        "arguments": {
                            "atMost": 1
                        }
                    }
                ]
            },
            {
                "all": [
                    {
                        "fileMatches": ".commandments/custom/samples/"
                    },
                    {
                        "not": {
                            "fileMatches": ".commandments/custom/samples/declarations/"
                        }
                    }
                ]
            }
        ]
    },
    "sin": {
        "name": "inline-declaration",
        "description": "A module or suite lists a declaration built in place, a call in its list, instead of the name of a class in its own file.",
        "rule": "A module lists class names: make the declaration a class in its own file and list that class. docs/writing-a-module.md shows the form.",
        "skill": "module-registration"
    }
}
