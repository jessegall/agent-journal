{
    "$schema": "../rule.schema.json",
    "engine": "python",
    "find": {
        "select": "assignment",
        "where": [
            {
                "fileMatches": "(^|/)src/tunnels/"
            },
            {
                "descendant": {
                    "all": [
                        {
                            "is": "identifier"
                        },
                        {
                            "nameMatches": "(?i)(token|password|secret|api_key)$"
                        }
                    ]
                }
            },
            {
                "descendant": {
                    "is": "literal"
                }
            }
        ],
        "reject": [
            {
                "testCode": true
            }
        ]
    },
    "sin": {
        "name": "secret-literal-in-tunnel",
        "description": "A tunnel module writes a token, a password or a secret as a value in its code.",
        "rule": "A tunnel's credentials stay with its program's own login or in a secret setting the person sets; never in the code.",
        "skill": "settings-architecture"
    }
}
