{
    "$schema": "commandments:neutral-rule/v2",
    "engine": "php",
    "sin": {
        "description": "A class, interface or enum is named with a verb phrase about what its implementer does.",
        "name": "type-name-is-noun",
        "rule": "Name a type with a noun for what it is or the role it plays (PipelineRunner, PageProvider), never a verb phrase such as RunsPipelines; traits and attributes keep verb names (rule 43).",
        "skill": "type-name-is-noun"
    },
    "find": {
        "select": "type",
        "as": "t",
        "where": [
            "and",
            [
                "proven",
                [
                    "reads",
                    "$t.name",
                    "third-person"
                ]
            ],
            [
                "not",
                [
                    "TypeNameIsSentenceDetector.isSentence",
                    "$t"
                ]
            ],
            [
                "!=",
                [
                    "typeKind",
                    "$t"
                ],
                "trait"
            ],
            [
                "not",
                [
                    "nonempty",
                    [
                        "annotated",
                        "$t",
                        "Attribute"
                    ]
                ]
            ],
            [
                "not",
                [
                    "matchesText",
                    "$t.name",
                    "^[A-Z][a-z]+$"
                ]
            ],
            [
                "not",
                [
                    "matchesText",
                    "$t.name",
                    "^(Domains|Exports|Links|Processes|Reads|Records|Reports)[A-Z]"
                ]
            ],
            [
                "not",
                [
                    "matchesText",
                    "$t.file.path",
                    "(^|/)tests/"
                ]
            ]
        ],
        "emit": "$t"
    }
}
