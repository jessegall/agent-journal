{
    "$schema": "../rule.schema.json",
    "engine": "python",
    "find": {
        "select": "parameter",
        "where": [
            {
                "parameterType": "Updated"
            },
            {
                "inside": {
                    "all": [
                        {
                            "is": "type-declaration"
                        },
                        {
                            "extendsAny": "BaseState"
                        }
                    ]
                }
            }
        ]
    },
    "sin": {
        "name": "state-hears-updated",
        "description": "A state's listener hears Updated.",
        "rule": "A state hears an event named for the moment, never a model's Updated.",
        "skill": "stack-machine"
    }
}
