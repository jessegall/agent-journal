{
    "$schema": "../rule.schema.json",
    "engine": "python",
    "find": {
        "select": "type-declaration",
        "where": [
            {
                "fileMatches": "^(\\.commandments/custom/samples/layout/)?src/.+\\.py$"
            },
            {
                "any": [
                    {
                        "typeKind": "enum"
                    },
                    {
                        "extendsAny": "Enum"
                    },
                    {
                        "extendsAny": "StrEnum"
                    },
                    {
                        "extendsAny": "IntEnum"
                    }
                ]
            }
        ],
        "reject": [
            {
                "fileMatches": "(^|/)enums/[^/]+\\.py$"
            },
            {
                "fileMatches": "(^|/)(dist|node_modules|vendor)/"
            },
            {
                "testCode": true
            },
            {
                "file": "src/engine/chat/mark_click.py"
            },
            {
                "file": "src/engine/chat/mark_colouring.py"
            },
            {
