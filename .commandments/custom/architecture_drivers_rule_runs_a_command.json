{
    "$schema": "../rule.schema.json",
    "engine": "python",
    "find": {
        "select": "call",
        "where": [
            {
                "nameIn": [
                    "run",
                    "dispatch",
                    "save",
                    "delete",
                    "execute",
                    "update",
                    "insert"
                ]
            },
            {
                "any": [
                    {
                        "extendsAny": "DriverRule",
                        "of": "enclosingType"
                    },
                    {
                        "extendsAny": "Overlay",
                        "of": "enclosingType"
                    },
                    {
                        "extendsAny": "AgentState",
                        "of": "enclosingType"
                    },
                    {
                        "extendsAny": "DeferredRule",
                        "of": "enclosingType"
                    }
                ]
            }
        ],
        "reject": [
            {
                "testCode": true
            },
            {
                "fileMatches": "(^|/)core/modules/plugins/rules/plugin_rule\\.py$"
            }
        ]
    },
    "sin": {
        "name": "rule-runs-a-command",
        "description": "A driver rule, an overlay, an agent state's opener or a deferred rule runs a command or writes a row itself, so the write skips the hook call's transaction, its savepoint and its record.",
        "rule": "A rule only answers: it hands the commands it wants run to RuleAnswer with running() or ending_layer(), and the hook record runs each one alone.",
        "skill": "drivers-architecture"
    }
}
