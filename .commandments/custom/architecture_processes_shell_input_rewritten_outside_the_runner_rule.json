{
    "$schema": "../rule.schema.json",
    "engine": "python",
    "find": {
        "select": "call",
        "where": [
            {
                "fileMatches": "(^|/)(src/|samples/processes/)"
            },
            {
                "any": [
                    {
                        "nameIn": [
                            "rewritten",
                            "rewriting_after_commands"
                        ]
                    },
                    {
                        "all": [
                            {
                                "name": "RuleAnswer"
                            },
                            {
                                "descendant": {
                                    "nameIn": [
                                        "updated_input",
                                        "input_after_commands"
                                    ]
                                }
                            }
                        ]
                    }
                ]
            }
        ],
        "reject": [
            {
                "testCode": true
            },
            {
                "fileMatches": "processes/rules/runner_rewrite_rule\\.py$"
            },
            {
                "fileMatches": "engine/driver/refusal_line\\.py$"
            },
            {
                "fileMatches": "engine/driver/rule_answer\\.py$"
            },
            {
                "all": [
                    {"fileMatches": "modules/drivers/rules/foreign_hooks_rule\\.py$"},
                    {"name": "RuleAnswer"}
                ]
            }
        ]
    },
    "sin": {
        "name": "shell-input-rewritten-outside-the-runner-rule",
        "description": "A rule other than the processes module's RunnerRewriteRule gives the tool a new input, so two rules compete for a shell line and the line may skip the runner.",
        "rule": "RunnerRewriteRule builds shell input for the runner; RefusalLine prints a refusal through a command. ForeignHooksRule forwards a managed hook's native replacement input for the existing rewrite-conflict check. Other rules answer with lines or a refusal.",
        "skill": "processes-architecture"
    }
}
