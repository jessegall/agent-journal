{
    "$schema": "../rule.schema.json",
    "engine": "python",
    "find": {
        "select": "parameter",
        "where": [
            {
                "nameMatches": "(?i)(^|_)(${poetic}|${poetic_values})(_|$)"
            }
        ],
        "reject": [
            {
                "nameMatches": "^(tmp_path|tmp_path_factory|capsys|monkeypatch|request)$"
            },
            {
                "name": "tmp_path"
            },
            {
                "nameIn": [
                    "f_back",
                    "exist_ok",
                    "missing_ok",
                    "dirs_exist_ok",
                    "symlink_to",
                    "target_is_directory",
                    "is_relative_to",
                    "add_argument",
                    "load_module",
                    "tmp_path",
                    "cache_info"
                ]
            }
        ]
    },
    "sin": {
        "name": "poetic-parameter-name",
        "description": "A parameter is named by a word that does not say what it is: said, whisper, tale, magic, made, thing, stuff, got, done.",
        "rule": "Name a parameter for what it holds, in an ordinary word: nudge, line, values.",
        "skill": "plain-code-words"
    }
}
