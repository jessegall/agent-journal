{
    "$schema": "../rule.schema.json",
    "engine": "python",
    "find": {
        "select": "type-declaration",
        "where": [
            {
                "fileMatches": "(^|/)src/suites/"
            },
            {
                "any": [
                    {
                        "extendsAny": "Migration"
                    }
                ]
            }
        ],
        "reject": [
            {
                "fileMatches": "(^|/)src/suites/[^/]+/(modules/[^/]+/)?migrations/[^/]+\\.py$"
            },
            {
                "testCode": true
            }
        ]
    },
    "sin": {
        "name": "suite-migration-outside-migrations",
        "description": "A suite's migration sits outside a migrations folder.",
        "rule": "A suite's migrations live in its migrations folder: src/suites/<suite>/migrations/ or src/suites/<suite>/modules/<module>/migrations/.",
        "skill": "plain-code-words"
    }
}
