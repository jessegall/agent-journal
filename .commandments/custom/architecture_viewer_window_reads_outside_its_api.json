{
    "$schema": "../rule.schema.json",
    "engine": "typescript",
    "find": {
        "select": "call",
        "where": [
            {
                "any": [
                    {
                        "nameIn": [
                            "useRows",
                            "useDeclaredRows",
                            "lineResult",
                            "readKeys",
                            "fetch"
                        ]
                    },
                    {
                        "all": [
                            {
                                "name": "read"
                            },
                            {
                                "descendant": {
                                    "name": "context"
                                }
                            }
                        ]
                    }
                ]
            },
            {
                "fileMatches": "(^|/)(web/src|src/viewer/src/chat)/.*\\.(vue|js)$"
            }
        ],
        "reject": [
            {
                "testCode": true
            },
            {
                "fileMatches": "(^|/)(core/modules/agents/web/src/AgentActions\\.vue|core/modules/agents/web/src/AgentCard\\.vue|core/modules/agents/web/src/AgentLimits\\.vue|core/modules/agents/web/src/AgentRows\\.vue|core/modules/agents/web/src/TranscriptRows\\.vue|core/modules/developer/web/src/HookRequests\\.vue|core/modules/developer/web/src/RequestQueueInspector\\.vue|core/modules/developer/web/src/SystemLogs\\.vue|core/modules/documents/web/src/DocumentLibrary\\.vue|core/modules/drivers/web/src/HookCallList\\.vue|core/modules/drivers/web/src/NudgeList\\.vue|core/modules/dumps/web/src/DumpDock\\.vue|core/modules/dumps/web/src/DumpRows\\.vue|core/modules/library/web/src/LibraryBrowse\\.vue|core/modules/library/web/src/LibraryCopies\\.vue|core/modules/library/web/src/LibraryPerson\\.vue|core/modules/mcp/web/src/ServerRows\\.vue|core/modules/memories/web/src/MemoryBrowser\\.vue|core/modules/memories/web/src/MemoryPane\\.vue|core/modules/memories/web/src/useCounts\\.js|core/modules/memories/web/src/usePagedRead\\.js|core/modules/messages/web/src/Attachments\\.vue|core/modules/messages/web/src/Chat\\.vue|core/modules/messages/web/src/QuestionOverlay\\.vue|core/modules/phone/web/src/PhoneRows\\.vue|core/modules/plan_reviews/web/src/PlanRounds\\.vue|core/modules/plans/web/src/PlanCards\\.vue|core/modules/plans/web/src/PlanDock\\.vue|core/modules/plugins/web/src/PluginRows\\.vue|core/modules/processes/web/src/OutputDock\\.vue|core/modules/processes/web/src/Output\\.vue|core/modules/processes/web/src/Outputs\\.vue|core/modules/profiles/web/src/HelperStartForm\\.vue|core/modules/profiles/web/src/ProfileRows\\.vue|core/modules/project_rules/web/src/RulesPage\\.vue|core/modules/questions/web/src/OpenQuestionsDock\\.vue|core/modules/questions/web/src/QuestionMarkCard\\.vue|core/modules/questions/web/src/QuestionRows\\.vue|core/modules/questions/web/src/WaitingRows\\.vue|core/modules/reminders/web/src/ReminderRows\\.vue|core/modules/reviews/web/src/ReviewerDropdown\\.vue|core/modules/reviews/web/src/ReviewerSteps\\.vue|core/modules/reviews/web/src/SubjectReviews\\.vue|core/modules/schedules/web/src/AgentJobs\\.vue|core/modules/search/web/src/SearchWindow\\.vue|core/modules/secrets/web/src/SecretRows\\.vue|core/modules/sequences/web/src/SequenceCards\\.vue|core/modules/settings/web/src/CommandSettings\\.vue|core/modules/settings/web/src/ProjectHooks\\.vue|core/modules/settings/web/src/SettingsEnvironments\\.vue|core/modules/settings/web/src/SettingsTree\\.vue|core/modules/sharing/web/src/ShareRows\\.vue|core/modules/skills/web/src/SkillTriggerEditor\\.vue|core/modules/skills/web/src/useSkillsPage\\.js|core/modules/suggestions/web/src/SuggestionRows\\.vue|core/modules/tasks/web/src/TaskGraphView\\.vue|core/modules/tasks/web/src/TaskGroups\\.vue|core/modules/tasks/web/src/planPlaces\\.js|core/modules/templates/web/src/TemplateCards\\.vue|core/modules/transcriptions/web/src/TranscriptionRows\\.vue|core/modules/triggers/web/src/TriggerCards\\.vue|core/modules/tunnel/web/src/TunnelWindow\\.vue|core/modules/updates/web/src/UpdatesPanel\\.vue|suites/coding/modules/checks/web/src/CheckCards\\.vue|suites/coding/modules/workers/web/src/Points\\.vue|suites/coding/modules/workers/web/src/ProjectWorktrees\\.vue|suites/coding/modules/workers/web/src/Todos\\.vue|suites/coding/modules/workers/web/src/WorkerDropdown\\.vue|suites/coding/modules/workers/web/src/WorkerModels\\.vue|suites/coding/modules/workers/web/src/WorkerRecent\\.vue|suites/coding/web/src/AgentFileEdits\\.vue|suites/coding/web/src/FileEdits\\.vue|suites/coding/web/src/FileFeed\\.vue|suites/coding/web/src/GitOverview\\.vue|suites/coding/web/src/ProjectFiles\\.vue|suites/coding/web/src/Terminal\\.vue|suites/coding/web/src/WorkMode\\.vue|viewer/src/chat/DockWrapper\\.vue)$"
            }
        ]
    },
    "sin": {
        "name": "window-reads-outside-its-api",
        "description": "A window reads its data by itself instead of through its keys, so it makes requests the window's one route cannot join or limit.",
        "rule": "Declare the data as keys in the window's module and read them through WindowApi: api.rows, api.key and api.reload({only}). A window on the rule's list is still to be converted by plan 1097.",
        "skill": "plain-code-words"
    }
}