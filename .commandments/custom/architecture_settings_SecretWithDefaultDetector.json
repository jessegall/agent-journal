{
    "$schema": "../rule.schema.json",
    "engine": "python",
    "find": {
        "select": "call",
        "where": [
            {
                "of": "child:func",
                "resolves": "core.base.setting.setting_value.SettingValue"
            },
            {
                "descendant": {
                    "all": [
                        {
                            "kind": "keyword"
                        },
                        {
                            "name": "secret"
                        }
                    ]
                }
            },
            {
                "descendant": {
                    "all": [
                        {
                            "kind": "keyword"
                        },
                        {
                            "name": "default"
                        }
                    ]
                }
            }
        ],
        "reject": [
            {
                "testCode": true
            }
        ]
    },
    "sin": {
        "name": "secret-setting-with-default",
        "description": "A secret setting declares a default, so a secret value is written in the code.",
        "rule": "A secret setting has no default: the person sets it with journal setting set, and the code reads it only through SettingValues.",
        "skill": "settings-architecture"
    }
}
