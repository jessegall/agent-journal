{
    "$schema": "../rule.schema.json",
    "engine": "python",
    "find": {
        "select": "type-declaration",
        "where": [
            {
                "fileMatches": "^(\\.commandments/custom/samples/layout/)?src/(core/base|engine)/[^/]+\\.py$"
            }
        ],
        "reject": [
            {
                "fileMatches": "(^|/)__init__\\.py$"
            },
            {
                "testCode": true
            },
            {
                "file": "src/core/base/agent_brief_points.py"
            },
            {
                "file": "src/core/base/agent_checkouts.py"
            },
            {
                "file": "src/core/base/agent_group.py"
            },
            {
                "file": "src/core/base/agent_group_book.py"
            },
            {
                "file": "src/core/base/agent_policy.py"
            },
            {
                "file": "src/core/base/agent_role_reader.py"
            },
            {
                "file": "src/core/base/agent_roster.py"
            },
            {
                "file": "src/core/base/agent_work.py"
            },
            {
                "file": "src/core/base/agent_write_folder.py"
            },
            {
                "file": "src/core/base/code_copy.py"
            },
            {
                "file": "src/core/base/conflict_files.py"
            },
            {
                "file": "src/core/base/file_access.py"
            },
            {
                "file": "src/core/base/file_changes.py"
            },
            {
                "file": "src/core/base/file_contents.py"
            },
            {
                "file": "src/core/base/file_fingerprints.py"
            },
            {
                "file": "src/core/base/file_state.py"
            },
            {
                "file": "src/core/base/file_version.py"
            },
            {
                "file": "src/core/base/helper_type.py"
            },
            {
                "file": "src/core/base/helper_type_book.py"
            },
            {
                "file": "src/core/base/kept_file_text.py"
            },
            {
                "file": "src/core/base/project_reads.py"
            },
            {
                "file": "src/core/base/rotated_file.py"
            }
        ]
    },
    "sin": {
        "name": "base-loose-class",
        "description": "A class sits loose directly in the engine folder, so it belongs to no folder.",
        "rule": "Move it into the folder of its area under the engine folder. Every class, function and value sits in a folder named for its sort: errors, enums, models, support or the folder of its area.",
        "skill": "plain-code-words"
    }
}
