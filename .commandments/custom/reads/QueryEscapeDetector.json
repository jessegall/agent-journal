{
    "$schema": "commandments:neutral-rule/v2",
    "engine": "php",
    "sin": {
        "description": "toBase() or getQuery() leaves the model's bounded read builder.",
        "name": "query-escape",
        "rule": "Stay on the model's builder so the read bound and the read order apply; only app/Reads and the bounded builder itself (app/Support/BoundedReadBuilder.php) may step out of it.",
        "skill": "bounded-reads"
    },
    "find": {
        "select": "call",
        "as": "c",
        "where": [
            "and",
            [
                "in",
                [
                    "coalesce",
                    "$c.callee.member.name",
                    "$c.callee.name"
                ],
                "toBase",
                "getQuery"
            ],
            [
                "not",
                [
                    "matchesText",
                    "$c.file.path",
                    "(^|/)app/(Reads/|Support/BoundedReadBuilder\\.php$)"
                ]
            ]
        ],
        "emit": "$c"
    }
}
