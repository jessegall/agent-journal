{
    "$schema": "commandments:neutral-rule/v2",
    "engine": "php",
    "sin": {
        "description": "Model::all() reads every row of a table with no bound.",
        "name": "model-read-all",
        "rule": "Read a set bounded by its where, a page with limit(n) or a scan with chunkById instead of Model::all().",
        "skill": "bounded-reads"
    },
    "find": {
        "select": "call",
        "as": "c",
        "where": [
            "and",
            [
                "=",
                [
                    "coalesce",
                    "$c.callee.member.name",
                    "$c.callee.name"
                ],
                "all"
            ],
            [
                "=",
                "$c.callee.form",
                "static"
            ],
            [
                "proven",
                [
                    "assignable",
                    [
                        "symbolOf",
                        "$c.callee.subject"
                    ],
                    "Illuminate\\Database\\Eloquent\\Model"
                ]
            ],
            [
                "not",
                [
                    "some",
                    [
                        "ancestors",
                        "$c"
                    ],
                    "a",
                    [
                        "and",
                        [
                            "is",
                            "$a",
                            "call"
                        ],
                        [
                            "in",
                            [
                                "coalesce",
                                "$a.callee.member.name",
                                "$a.callee.name"
                            ],
                            "assertThrows"
                        ]
                    ]
                ]
            ]
        ],
        "emit": "$c"
    }
}
