{
    "$schema": "commandments:neutral-rule/v2",
    "engine": "php",
    "sin": {
        "description": "An accessor runs a query, so every read of the attribute queries again.",
        "name": "query-in-accessor",
        "rule": "An accessor computes from what is loaded; load the relation with with() and read it there.",
        "skill": "bounded-reads"
    },
    "find": {
        "select": "function",
        "as": "f",
        "where": [
            "and",
            [
                "matchesText",
                "$f.name",
                "^get[A-Z][A-Za-z]*Attribute$"
            ],
            [
                "some",
                [
                    "descendants",
                    "$f",
                    "call"
                ],
                "d",
                [
                    "in",
                    [
                        "coalesce",
                        "$d.callee.member.name",
                        "$d.callee.name"
                    ],
                    "query",
                    "where",
                    "get",
                    "first",
                    "count",
                    "exists",
                    "sole",
                    "pluck"
                ]
            ]
        ],
        "emit": "$f"
    }
}
