{
    "$schema": "../../rule.schema.json",
    "engine": "php",
    "find": {
        "select": "call",
        "where": [
            {
                "nameIn": [
                    "find",
                    "findOrFail",
                    "first",
                    "firstOrFail",
                    "sole",
                    "firstWhere"
                ]
            },
            {
                "withinLoop": true
            },
            {
                "any": [
                    {
                        "resolvesLike": "Illuminate\\Database\\*",
                        "of": "child:var"
                    },
                    {
                        "resolvesLike": "App\\*\\Models\\*",
                        "of": "child:var"
                    },
                    {
                        "resolvesLike": "Domain\\*\\Models\\*",
                        "of": "child:var"
                    },
                    {
                        "resolvesLike": "App\\*\\Models\\*",
                        "of": "child:class"
                    },
                    {
                        "resolvesLike": "Domain\\*\\Models\\*",
                        "of": "child:class"
                    },
                    {
                        "descendant": {
                            "all": [
                                {
                                    "is": "call"
                                },
                                {
                                    "name": "query"
                                }
                            ]
                        }
                    }
                ]
            }
        ],
        "reject": [
            {
                "testCode": true
            }
        ]
    },
    "sin": {
        "description": "A row is read once per item of a loop.",
        "name": "load-in-loop",
        "rule": "Read every row the loop needs in one query before the loop (whereKey, whereIn, with), or use readInChunks.",
        "skill": "bounded-reads"
    }
}
