{
    "$schema": "commandments:neutral-rule/v2",
    "engine": "php",
    "sin": {
        "description": "A row is read once per item of a loop.",
        "name": "load-in-loop",
        "rule": "Read every row the loop needs in one query before the loop (whereKey, whereIn, with), or use readInChunks.",
        "skill": "bounded-reads"
    },
    "find": {
        "select": "call",
        "as": "c",
        "where": [
            "and",
            [
                "in",
                [
                    "coalesce",
                    "$c.callee.member.name",
                    "$c.callee.name"
                ],
                "find",
                "findOrFail",
                "first",
                "firstOrFail",
                "sole",
                "firstWhere"
            ],
            [
                "exists",
                [
                    "enclosing",
                    "$c",
                    "loop",
                    "function"
                ]
            ],
            [
                "not",
                "$c.file.test"
            ],
            [
                "or",
                [
                    "matchesText",
                    [
                        "symbolOf",
                        "$c"
                    ],
                    "^(Illuminate\\\\Database\\\\|(App|Domain)\\\\.*\\\\Models\\\\)"
                ],
                [
                    "matchesText",
                    [
                        "symbolOf",
                        "$c.callee.subject"
                    ],
                    "^(App|Domain)\\\\.*\\\\Models\\\\"
                ],
                [
                    "some",
                    [
                        "descendants",
                        "$c",
                        "call"
                    ],
                    "d",
                    [
                        "=",
                        [
                            "coalesce",
                            "$d.callee.member.name",
                            "$d.callee.name"
                        ],
                        "query"
                    ]
                ]
            ]
        ],
        "emit": "$c"
    }
}
