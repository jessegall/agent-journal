{
    "$schema": "../rule.schema.json",
    "engine": "python",
    "find": {
        "select": "type-declaration",
        "where": [
            {
                "any": [
                    {
                        "all": [
                            {
                                "fileMatches": "(^|/)src/(suites|core/modules)/.+/commands/[^/]+/[^/]+_handler\\.py$"
                            },
                            {
                                "extendsAny": "Handler"
                            },
                            {
                                "descendant": {
                                    "all": [
                                        {
                                            "is": "identifier"
                                        },
                                        {
                                            "nameIn": [
                                                "WorktreeGit",
                                                "shutil"
                                            ]
                                        }
                                    ]
                                }
                            }
                        ]
                    },
                    {
                        "all": [
                            {
                                "fileMatches": "(^|/)src/(suites|core/modules)/"
                            },
                            {
                                "any": [
                                    {
                                        "extendsAny": "SaveListener"
                                    },
                                    {
                                        "extendsAny": "DeletionListener"
                                    },
                                    {
                                        "extendsAny": "Guard"
                                    }
                                ]
                            },
                            {
                                "any": [
                                    {
                                        "descendant": {
                                            "all": [
                                                {
                                                    "is": "identifier"
                                                },
                                                {
                                                    "nameIn": [
                                                        "WorktreeGit",
                                                        "shutil",
                                                        "ProcessGroup"
                                                    ]
                                                }
                                            ]
                                        }
                                    },
                                    {
                                        "descendant": {
                                            "all": [
                                                {
                                                    "is": "member-access"
                                                },
                                                {
                                                    "name": "remove"
                                                },
                                                {
                                                    "declaredBy": "*OutputFolder"
                                                }
                                            ]
                                        }
                                    }
                                ]
                            }
                        ]
                    }
                ]
            }
        ],
        "reject": [
            {
                "descendant": {
                    "all": [
                        {
                            "is": "identifier"
                        },
                        {
                            "nameIn": [
                                "runs_once"
                            ]
                        }
                    ]
                }
            },
            {
                "testCode": true
            }
        ]
    },
    "sin": {
        "name": "handler-repeats-outside-work",
        "description": "A handler, save listener, deletion listener or guard does work outside the database inside a transaction that can roll back and run again.",
        "rule": "A command can run again after a rollback, so do this work in prepare or a commit listener, or set runs_once.",
        "skill": "plain-code-words"
    }
}
