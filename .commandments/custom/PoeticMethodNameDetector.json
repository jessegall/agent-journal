{
    "$schema": "../rule.schema.json",
    "engine": "python",
    "find": {
        "select": "function",
        "where": [
            {
                "nameMatches": "^(chose|gave|took|wrote|drew|threw|began|forgot|about|worded|meaning|whisper|murmur|mutter|muse|ponder|wonder|dream|spoken|telling|utter|tell|says|said|speak|spoke|hear|heard|heed|recite|chant|sing|stay|dwell|linger|tarry|behold|glance|gaze|peek|glimpse|grok|munge|wrangle|fiddle|massage|tinker|bless|curse|conjure|summon|enchant|forge|craft|weave|wield|kindle|awaken|snapshot|stance|posture|footing|bearing|look|looked|gazed|noticed|spotted|caught|grasped|felt|sensed|knew|learned|remembered|forgot|forgotten|recalled|went|came|fell|rose|stood|sat|lay|awoke|woke|wandered|strayed|drifted|readings|reading|picture|impression|sense|feel|notion|outlook|landscape|terrain|scene|backdrop|climate|weather|tide|wave|footprint|shadow|mirror|pulse|breath|temper|flavour|taste|scent|shade|hue|spot|catch|offer|owe|owed|pay|paid|pays|carry|carried|land|landed|settle|settled|sweep|swept|tidy|cope|deal|hush|born|birth|heal|say|says|held|hold|holds|holding|named|back|forth|told|untold|owes|owing|mark|marked|park|parked|kept|keep|bring|brought|carries|carrying|await|awaiting|awaited|expecting|hearing|hears|live|quiet|lately|oriented|drawn|whispered|made|come|let_go|stands|stands_in_for|stuck|fresh|survives|leaves|leaves_by_itself|met_by|given_on|put_off|begun|up|became|taken|take|through|pushed_through|popped_through|read_for|follows|follows_a_plan|speaks|is_due|has_news|has_just|ran_out)$"
            }
        ]
    },
    "sin": {
        "name": "poetic-method-name",
        "description": "A method is named by a word that does not say what it does: about, worded, meaning, whisper, tell.",
        "rule": "Name a method for what it does, in an ordinary word: create, rendered, with_values, on_tool_starting.",
        "skill": "plain-code-words"
    }
}
