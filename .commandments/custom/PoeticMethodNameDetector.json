{
    "$schema": "../rule.schema.json",
    "engine": "python",
    "find": {
        "select": "function",
        "where": [
            {
                "nameMatches": "^(about|worded|meaning|whisper|murmur|mutter|muse|ponder|wonder|dream|spoken|telling|utter|tell|says|said|speak|spoke|hear|heard|heed|recite|chant|sing|stay|dwell|linger|tarry|behold|glance|gaze|peek|glimpse|grok|munge|wrangle|fiddle|massage|tinker|bless|curse|conjure|summon|enchant|forge|craft|weave|wield|kindle|awaken)$"
            }
        ]
    },
    "sin": {
        "name": "poetic-method-name",
        "description": "A method is named by a word that does not say what it does: about, worded, meaning, whisper, tell.",
        "rule": "Name a method for what it does, in an ordinary word: create, rendered, with_values, on_tool_starting.",
        "skill": "plain-code-words"
    }
}
