{
    "$schema": "../rule.schema.json",
    "engine": [
        "go",
        "python"
    ],
    "find": {
        "reject": [
            {
                "name": "named_line"
            },
            {
                "all": [
                    {
                        "nameLike": "test_*"
                    },
                    {
                        "file": "tests/stories/**"
                    }
                ]
            },
            {
                "nameMatches": "^test_"
            },
            {
                "all": [
                    {
                        "nameMatches": "^[a-z][0-9]+_"
                    },
                    {
                        "file": "tests/stories/**"
                    }
                ]
            }
        ],
        "select": "function",
        "where": [
            {
                "nameMatches": "(?i)(^|_)(${poetic}|any|awaken|bare|began|behold|bless|chant|chose|conjure|craft|drew|enchant|fiddle|followed|follows|follows_a_plan|forge|forget|gaze|glance|grok|has_just|has_news|heed|is_due|kindle|knowing|later|leaves_by_itself|led|left_behind|massage|munge|off|out|over|peek|ponder|popped_through|pushed_through|ran_out|read_for|recite|saw|shipped|sing|speak|speaks|stands_in_for|stray|summon|taken_over|than|their|threw|through|tinker|turned|under|weave|wield|wonder|wrangle)(_|$)"
            }
        ]
    },
    "sin": {
        "description": "A method is named by a word that does not say what it does: about, worded, meaning, whisper, tell.",
        "name": "poetic-method-name",
        "rule": "Name a method for what it does, in an ordinary word: create, rendered, with_values, on_tool_starting.",
        "skill": "plain-code-words"
    }
}
