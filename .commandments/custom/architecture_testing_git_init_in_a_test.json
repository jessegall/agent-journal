{
    "$schema": "../rule.schema.json",
    "engine": "python",
    "find": {
        "select": "literal",
        "where": [
            {
                "text": "init"
            },
            {
                "fileMatches": "(^|/)tests/(stories|unit|install)/"
            }
        ],
        "reject": [
            {
                "fileMatches": "(^|/)tests/(stories/suites/coding/modules/workers/support/git_repository|stories/core/modules/agents/hook_sweep_failures|stories/core/modules/plugins/previews_and_boards|stories/suites/coding/git_overview|unit/engine/git/test_hook_files_git|unit/engine/provider/test_hook_manager)\\.py$"
            },
            {
                "fileMatches": "(^|/)tests/(stories/core/modules/developer/private_data_scan|stories/suites/coding/support/graphify_repo|unit/suites/coding/modules/workers/test_worktree_git_own_files|unit/scripts/test_rename|unit/scripts/test_move_tool_stories|unit/scripts/samples/sample_repository)\\.py$"
            },
            {
                "fileMatches": "(^|/)tests/(stories/core/modules/agents/project_hook_files|stories/core/modules/settings/project_hooks|stories/suites/coding/modules/workers/send_left_out|unit/suites/coding/modules/workers/test_worktree_git_behind|unit/suites/coding/modules/workers/test_worktree_git_earlier_branch)\\.py$"
            }
        ]
    },
    "sin": {
        "name": "git-init-in-a-test",
        "description": "A test makes its own git repository, which starts several git processes.",
        "rule": "Copy the sample through GitRepository.sample. A test whose subject is a fresh repository is named in this rule with that reason; SampleRepository is the fresh repository of the refactoring scripts' tests.",
        "skill": "plain-code-words"
    }
}
