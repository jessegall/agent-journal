{
    "$schema": "../rule.schema.json",
    "engine": "python",
    "find": {
        "select": "call",
        "where": [
            {
                "nameIn": [
                    "refused"
                ]
            },
            {
                "fileMatches": "/rules/[a-z_]+_rule\\.py$"
            }
        ],
        "reject": [
            {
                "fileMatches": "/documents/rules/open_document_rule\\.py$"
            },
            {
                "fileMatches": "/rules/(panic_file_rule|private_corpus_rule|unknown_command_rule|plugin_program_rule|reading_rule|graphify_search_rule|checkout_write_code_rule|protected_folder_rule)\\.py$"
            },
            {
                "fileMatches": "/rules/(runner_rewrite_rule|profile_skill_first_rule|access_rule|native_subagent_rule|allowed_command_types_rule|allowed_tools_rule|denied_programs_rule|denied_tools_rule|no_full_test_run_rule|saved_command_rule)\\.py$"
            },
            {
                "testCode": true
            },
            {
                "of": "enclosingType",
                "descendant": {
                    "all": [
                        {
                            "is": "assignment"
                        },
                        {
                            "child": {
                                "name": "single_action_refusal"
                            }
                        }
                    ]
                }
            }
        ]
    },
    "sin": {
        "name": "block-outside-block-until",
        "description": "A rule holds an agent's tools by itself until something becomes true, so its exceptions and its ending are its own.",
        "rule": "Hold an agent with RuleAnswer.blocked(hook, NUDGE, condition): a block refuses everything but reading and journal commands and ends when its condition is true. A rule that refuses one action outright declares why in single_action_refusal.",
        "skill": "plain-code-words"
    }
}
