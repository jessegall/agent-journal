{
    "$schema": "../rule.schema.json",
    "engine": "python",
    "find": {
        "select": "call",
        "where": [
            {
                "nameIn": [
                    "refused"
                ]
            },
            {
                "fileMatches": "/rules/[a-z_]+_rule\\.py$"
            }
        ],
        "reject": [
            {
                "fileMatches": "/documents/rules/open_document_rule\\.py$"
            },
            {
                "fileMatches": "/rules/(panic_file_rule|private_corpus_rule|unknown_command_rule|plugin_program_rule|silent_start_rule|graphify_search_rule|main_file_write_rule|protected_folder_rule)\\.py$"
            },
            {
                "fileMatches": "/rules/(runner_rewrite_rule|access_rule|native_subagent_rule|allowed_command_types_rule|allowed_tools_rule|denied_programs_rule|denied_tools_rule|no_full_test_run_rule|saved_command_rule)\\.py$"
            },
            {
                "testCode": true
            },
            {
                "fileMatches": "/rules/(helper_allowance_rule|worker_read_rule|alias_expansion_rule|agent_block_rule|redirected_run_rule|retry_loop_rule|dispatch_law_rule|phase_test_rule|sleep_poll_rule|journal_pipe_rule|journal_chain_rule|read_command_output_rule|hand_made_monitor_rule|folder_change_rule|native_memory_rule|secrets_folder_rule|phrase_trigger_rule|own_question_tool_rule|worker_git_rule|worker_full_test_run_rule|worker_test_count_rule|worker_judge_scope_rule|worker_reuse_rule|subagent_reuse_rule|worker_command_type_rule|subagent_allowance_rule|subagent_write_rule|dispatch_allowance_rule|worker_file_rule|worker_test_turn_rule|unread_message_show_rule|step_guard_rule|task_stop_rule|unread_message_stop_rule|unread_skill_stop_rule|worker_stop_rule|open_task_assignment_rule|open_task_stop_rule|delivered_work_stop_rule|blocked_work_rule)\\.py$"
            },
            {
                "fileMatches": "/rules/[a-z_]+_stop_rule\\.py$"
            },
            {
                "file": "**/processes/rules/failed_full_run_rule.py"
            }
        ]
    },
    "sin": {
        "name": "block-outside-block-until",
        "description": "A rule holds an agent's tools by itself until something becomes true, so its exceptions and its ending are its own.",
        "rule": "Hold an agent with RuleAnswer.blocked(hook, NUDGE, condition): a block refuses everything but reading and journal commands and ends when its condition is true. A rule that refuses one action outright is named in this rule's list.",
        "skill": "plain-code-words"
    }
}
