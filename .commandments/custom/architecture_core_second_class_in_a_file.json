{
    "$schema": "../rule.schema.json",
    "engine": "python",
    "find": {
        "select": "type-declaration",
        "where": [
            {
                "topLevel": true
            },
            {
                "count": {
                    "child": {
                        "is": "type-declaration"
                    },
                    "atLeast": 2
                },
                "of": "parent"
            },
            {
                "any": [
                    {
                        "fileMatches": "(^|/)src/"
                    },
                    {
                        "fileMatches": "samples/layout/"
                    }
                ]
            }
        ],
        "reject": [
            {
                "testCode": true
            }
        ]
    },
    "sin": {
        "name": "second-class-in-a-file",
        "description": "A module holds two or more classes, so a reader cannot find a class by its file name.",
        "rule": "Every class, enum and dataclass has a file of its own, named after it in snake_case; give each class of this module a file of its own and import it.",
        "skill": "plain-code-words"
    }
}
