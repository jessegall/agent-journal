{
    "$schema": "../rule.schema.json",
    "engine": "python",
    "find": {
        "select": "call",
        "where": [
            {
                "name": "NudgeDeclaration"
            },
            {
                "argument": {
                    "at": 1,
                    "name": "INSTRUCTION"
                }
            },
            {
                "argument": {
                    "at": 2,
                    "textMatches": "journal [a-z-]+ [a-z-]+"
                }
            }
        ],
        "reject": [
            {
                "descendant": {
                    "name": "required_command"
                }
            },
            {
                "testCode": true
            }
        ]
    },
    "sin": {
        "name": "instruction-without-payment",
        "description": "A line tells the agent to run a journal command and does not declare whether that command pays it, so the agent can ignore it for ever.",
        "rule": "Give the NudgeDeclaration required_command=\"<the command>\" so the line becomes a debt, or required_command=\"\" to say the line is only advice.",
        "skill": "plain-code-words"
    }
}
