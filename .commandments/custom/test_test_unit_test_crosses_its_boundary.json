{
    "$schema": "../rule.schema.json",
    "engine": "python",
    "sin": {
        "name": "test-unit-test-crosses-its-boundary",
        "description": "A unit test imports a module of core/modules, the story builder or a story helper.",
        "rule": "A unit test imports only its own unit, engine, server and the standard library; behaviour of a module is proved by a story. The unit tests of engine.testing import engine.testing, their own unit.",
        "skill": "unit-tests-stay-in-their-unit"
    },
    "find": {
        "select": "import",
        "where": [
            {
                "fileMatches": "(^|/)tests/unit/"
            },
            {
                "any": [
                    {
                        "nameMatches": "^(core\\.modules|engine\\.testing|tests\\.stories)(\\.|$)"
                    },
                    {
                        "descendant": {
                            "all": [
                                {
                                    "kind": "alias"
                                },
                                {
                                    "nameMatches": "^(core\\.modules|engine\\.testing|tests\\.stories)(\\.|$)"
                                }
                            ]
                        }
                    }
                ]
            }
        ],
        "reject": [
            {
                "all": [
                    {
                        "fileMatches": "(^|/)tests/unit/engine/testing/"
                    },
                    {
                        "any": [
                            {
                                "nameMatches": "^engine\\.testing(\\.|$)"
                            },
                            {
                                "descendant": {
                                    "all": [
                                        {
                                            "kind": "alias"
                                        },
                                        {
                                            "nameMatches": "^engine\\.testing(\\.|$)"
                                        }
                                    ]
                                }
                            }
                        ]
                    }
                ]
            },
            {
                "all": [
                    {
                        "fileMatches": "(^|/)tests/unit/core/modules/"
                    },
                    {
                        "any": [
                            {
                                "nameMatches": "^core\\.modules(\\.|$)"
                            },
                            {
                                "descendant": {
                                    "all": [
                                        {
                                            "kind": "alias"
                                        },
                                        {
                                            "nameMatches": "^core\\.modules(\\.|$)"
                                        }
                                    ]
                                }
                            }
                        ]
                    }
                ]
            },
            {
                "all": [
                    {
                        "fileMatches": "(^|/)tests/unit/suites/"
                    },
                    {
                        "any": [
                            {
                                "nameMatches": "^core\\.modules(\\.|$)"
                            },
                            {
                                "descendant": {
                                    "all": [
                                        {
                                            "kind": "alias"
                                        },
                                        {
                                            "nameMatches": "^core\\.modules(\\.|$)"
                                        }
                                    ]
                                }
                            }
                        ]
                    }
                ]
            }
        ]
    }
}
