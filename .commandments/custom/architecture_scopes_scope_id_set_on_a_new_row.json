{
    "$schema": "../rule.schema.json",
    "engine": "python",
    "find": {
        "select": "call",
        "where": [
            {
                "any": [
                    {
                        "constructs": "core.modules.*.models.*"
                    },
                    {
                        "constructs": "suites.*.models.*"
                    },
                    {
                        "child": {
                            "all": [
                                {
                                    "is": "identifier"
                                },
                                {
                                    "any": [
                                        {
                                            "resolvesLike": "core.modules.*.models.*"
                                        },
                                        {
                                            "resolvesLike": "suites.*.models.*"
                                        }
                                    ]
                                }
                            ]
                        }
                    }
                ]
            },
            {
                "child": {
                    "all": [
                        {
                            "kind": "keyword"
                        },
                        {
                            "nameIn": [
                                "environment_id",
                                "agent_id"
                            ]
                        }
                    ]
                }
            }
        ],
        "reject": [
            {
                "testCode": true
            },
            {
                "file": "**/migrations/**"
            },
            {
                "file": "**/upgrade/**"
            },
            {
                "file": "**/settings/commands/support/setting_store.py"
            },
            {
                "file": "**/record_journal_exception/record_journal_exception_handler.py"
            }
        ]
    },
    "sin": {
        "name": "scope-id-set-on-a-new-row",
        "description": "A new row names its environment or agent by hand, though the scope set at the door fills both.",
        "rule": "Leave the field out: Scopes.applied fills it from the scope of the request or hook.",
        "skill": "plain-code-words"
    }
}
