{
    "$schema": "../rule.schema.json",
    "engine": "python",
    "find": {
        "select": "literal",
        "where": [
            {
                "inside": {
                    "all": [
                        {
                            "is": "type-declaration"
                        },
                        {
                            "any": [
                                {
                                    "extendsAny": "Policy"
                                },
                                {
                                    "extendsAny": "EventPolicy"
                                },
                                {
                                    "extendsAny": "NeedSource"
                                },
                                {
                                    "extendsAny": "LineSource"
                                },
                                {
                                    "extendsAny": "EventLineSource"
                                },
                                {
                                    "extendsAny": "Effect"
                                },
                                {
                                    "extendsAny": "Transform"
                                },
                                {
                                    "extendsAny": "WakeCause"
                                }
                            ]
                        }
                    ]
                }
            },
            {
                "inside": {
                    "all": [
                        {
                            "is": "assignment"
                        },
                        {
                            "descendant": {
                                "all": [
                                    {
                                        "is": "identifier"
                                    },
                                    {
                                        "name": "events"
                                    }
                                ]
                            }
                        }
                    ]
                }
            }
        ],
        "reject": [
            {
                "testCode": true
            }
        ]
    },
    "sin": {
        "name": "hook-named-by-a-string",
        "description": "A contribution of the agent machine names an event it hears by a string, so a misspelt event passes until sync and the names are written out again in every contribution.",
        "rule": "Name each event by its member: events = [HookEventName.PRE_TOOL_USE].",
        "skill": "plain-code-words"
    }
}
