{
    "$schema": "../rule.schema.json",
    "engine": "python",
    "find": {
        "select": "call",
        "where": [
            {
                "nameIn": [
                    "read_text",
                    "read_bytes",
                    "write_text",
                    "write_bytes",
                    "open",
                    "unlink"
                ]
            },
            {
                "of": "child:func",
                "all": [
                    {
                        "is": "member-access"
                    },
                    {
                        "of": "child:value",
                        "all": [
                            {
                                "is": "call"
                            },
                            {
                                "of": "child:func",
                                "all": [
                                    {
                                        "is": "member-access"
                                    },
                                    {
                                        "name": "path"
                                    },
                                    {
                                        "of": "child:value",
                                        "is": "identifier"
                                    }
                                ]
                            }
                        ]
                    }
                ]
            }
        ],
        "reject": [
            {
                "file": "controllers/stored.py"
            },
            {
                "file": "migrations/**"
            },
            {
                "testCode": true
            }
        ]
    },
    "sin": {
        "name": "row-outside-repository",
        "description": "A row file is read, written or removed through a controller's own path, past the repository that owns the rows.",
        "rule": "Read and write a row through its controller or its rows (RowStore): peek, load, summaries, persist, remove. Only the repository touches a row file.",
        "skill": "rows-through-their-repository"
    }
}
