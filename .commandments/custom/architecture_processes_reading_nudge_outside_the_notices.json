{
    "$schema": "../rule.schema.json",
    "engine": "python",
    "find": {
        "select": "call",
        "where": [
            {
                "any": [
                    {
                        "all": [
                            {
                                "name": "nudge"
                            },
                            {
                                "of": "receiver",
                                "nameMatches": "^(${reading_declarations})$"
                            }
                        ]
                    },
                    {
                        "argument": {
                            "nameMatches": "^(${reading_declarations})$"
                        }
                    }
                ]
            },
            {
                "fileMatches": "(^|/)core/"
            }
        ],
        "reject": [
            {
                "testCode": true
            },
            {
                "fileMatches": "(^|/)core/modules/processes/support/(process_nudges|reading/reading_notices|cadence/cadence_nudges)\\.py$"
            }
        ]
    },
    "sin": {
        "name": "reading-nudge-outside-the-notices",
        "description": "A rule, a listener or a tick says a reading or cadence notice itself, so the same case can be told twice or in two ways.",
        "rule": "Send a reading notice through ReadingNotices and a cadence notice through CadenceNudges and WarnCadenceHandler.",
        "skill": "processes-architecture"
    }
}
