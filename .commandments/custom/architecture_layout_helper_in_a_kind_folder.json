{
    "$schema": "../rule.schema.json",
    "engine": "python",
    "find": {
        "select": "type-declaration",
        "where": [
            {
                "any": [
                    {
                        "all": [
                            {
                                "fileMatches": "(^|/)src/(suites|core/modules)/.+/models/[^/]+\\.py$"
                            },
                            {
                                "not": {
                                    "any": [
                                        {
                                            "extendsAny": "Model"
                                        },
                                        {
                                            "extendsAny": "ViewModel"
                                        }
                                    ]
                                }
                            }
                        ]
                    },
                    {
                        "all": [
                            {
                                "fileMatches": "(^|/)src/(suites|core/modules)/.+/lifecycles/[^/]+\\.py$"
                            },
                            {
                                "not": {
                                    "any": [
                                        {
                                            "extendsAny": "Lifecycle"
                                        }
                                    ]
                                }
                            }
                        ]
                    },
                    {
                        "all": [
                            {
                                "fileMatches": "(^|/)src/(suites|core/modules)/.+/enums/[^/]+\\.py$"
                            },
                            {
                                "not": {
                                    "any": [
                                        {
                                            "extendsAny": "StrEnum"
                                        },
                                        {
                                            "extendsAny": "IntEnum"
                                        },
                                        {
                                            "extendsAny": "Enum"
                                        }
                                    ]
                                }
                            }
                        ]
                    },
                    {
                        "all": [
                            {
                                "fileMatches": "(^|/)src/(suites|core/modules)/.+/commands/[^/]+/[^/]+\\.py$"
                            },
                            {
                                "not": {
                                    "any": [
                                        {
                                            "fileMatches": "/commands/support/"
                                        }
                                    ]
                                }
                            },
                            {
                                "not": {
                                    "any": [
                                        {
                                            "extendsAny": "Command"
                                        },
                                        {
                                            "extendsAny": "MoveCommand"
                                        },
                                        {
                                            "extendsAny": "Handler"
                                        },
                                        {
                                            "extendsAny": "Subcommand"
                                        },
                                        {
                                            "extendsAny": "ReadSubcommand"
                                        }
                                    ]
                                }
                            }
                        ]
                    },
                    {
                        "all": [
                            {
                                "fileMatches": "(^|/)src/(suites|core/modules)/.+/guards/[^/]+\\.py$"
                            },
                            {
                                "not": {
                                    "any": [
                                        {
                                            "extendsAny": "Guard"
                                        }
                                    ]
                                }
                            }
                        ]
                    },
                    {
                        "all": [
                            {
                                "fileMatches": "(^|/)src/(suites|core/modules)/.+/listeners/[^/]+\\.py$"
                            },
                            {
                                "not": {
                                    "any": [
                                        {
                                            "extendsAny": "SaveListener"
                                        },
                                        {
                                            "extendsAny": "CommitListener"
                                        },
                                        {
                                            "extendsAny": "DeletionListener"
                                        }
                                    ]
                                }
                            }
                        ]
                    },
                    {
                        "all": [
                            {
                                "fileMatches": "(^|/)src/(suites|core/modules)/.+/migrations/[^/]+\\.py$"
                            },
                            {
                                "not": {
                                    "any": [
                                        {
                                            "extendsAny": "Migration"
                                        },
                                        {
                                            "extendsAny": "RebuildMigration"
                                        }
                                    ]
                                }
                            }
                        ]
                    },
                    {
                        "all": [
                            {
                                "fileMatches": "(^|/)src/(suites|core/modules)/.+/queries/[^/]+\\.py$"
                            },
                            {
                                "not": {
                                    "any": [
                                        {
                                            "extendsAny": "Query"
                                        }
                                    ]
                                }
                            }
                        ]
                    },
                    {
                        "all": [
                            {
                                "fileMatches": "(^|/)src/(suites|core/modules)/.+/events/[^/]+\\.py$"
                            },
                            {
                                "not": {
                                    "any": [
                                        {
                                            "extendsAny": "Changed"
                                        }
                                    ]
                                }
                            }
                        ]
                    },
                    {
                        "all": [
                            {
                                "fileMatches": "(^|/)src/(suites|core/modules)/.+/policies/[^/]+\\.py$"
                            },
                            {
                                "not": {
                                    "any": [
                                        {
                                            "extendsAny": "Policy"
                                        },
                                        {
                                            "extendsAny": "EventPolicy"
                                        }
                                    ]
                                }
                            }
                        ]
                    },
                    {
                        "all": [
                            {
                                "fileMatches": "(^|/)src/(suites|core/modules)/.+/needs/[^/]+\\.py$"
                            },
                            {
                                "not": {
                                    "any": [
                                        {
                                            "extendsAny": "NeedSource"
                                        }
                                    ]
                                }
                            }
                        ]
                    },
                    {
                        "all": [
                            {
                                "fileMatches": "(^|/)src/(suites|core/modules)/.+/lines/[^/]+\\.py$"
                            },
                            {
                                "not": {
                                    "any": [
                                        {
                                            "extendsAny": "LineSource"
                                        },
                                        {
                                            "extendsAny": "EventLineSource"
                                        }
                                    ]
                                }
                            }
                        ]
                    },
                    {
                        "all": [
                            {
                                "fileMatches": "(^|/)src/(suites|core/modules)/.+/effects/[^/]+\\.py$"
                            },
                            {
                                "not": {
                                    "any": [
                                        {
                                            "extendsAny": "Effect"
                                        }
                                    ]
                                }
                            }
                        ]
                    },
                    {
                        "all": [
                            {
                                "fileMatches": "(^|/)src/(suites|core/modules)/.+/transforms/[^/]+\\.py$"
                            },
                            {
                                "not": {
                                    "any": [
                                        {
                                            "extendsAny": "Transform"
                                        }
                                    ]
                                }
                            }
                        ]
                    },
                    {
                        "all": [
                            {
                                "fileMatches": "(^|/)src/(suites|core/modules)/.+/wake_causes/[^/]+\\.py$"
                            },
                            {
                                "not": {
                                    "any": [
                                        {
                                            "extendsAny": "WakeCause"
                                        }
                                    ]
                                }
                            }
                        ]
                    }
                ]
            }
        ],
        "reject": [
            {
                "testCode": true
            }
        ]
    },
    "sin": {
        "name": "helper-in-a-kind-folder",
        "description": "A class sits among the classes of a kind folder it is not (models, lifecycles, enums, commands, guards, listeners, migrations, policies, needs, lines, effects, transforms or wake causes) instead of its own folder or a support folder.",
        "rule": "A kind folder holds only its kind: a helper goes into the support folder beneath the kind it serves, such as needs/support/.",
        "skill": "plain-code-words"
    }
}
