{
    "$schema": "commandments:neutral-rule/v2",
    "engine": "php",
    "sin": {
        "description": "A model's casts() comes after another method instead of directly below its attributes.",
        "name": "model-casts-below-attributes",
        "rule": "Put casts() first among a model's methods, directly below its constants, properties and class attributes.",
        "skill": "model-casts-below-attributes"
    },
    "find": {
        "select": "function",
        "as": "f",
        "where": [
            "and",
            [
                "=",
                "$f.name",
                "casts"
            ],
            [
                "proven",
                [
                    "assignable",
                    [
                        "symbolOf",
                        [
                            "enclosing",
                            "$f",
                            "type"
                        ]
                    ],
                    "Illuminate\\Database\\Eloquent\\Model"
                ]
            ],
            [
                "some",
                [
                    "before",
                    "$f"
                ],
                "b",
                [
                    "is",
                    "$b",
                    "function"
                ]
            ]
        ],
        "emit": "$f"
    }
}
