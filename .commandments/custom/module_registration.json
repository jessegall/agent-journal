{
    "$schema": "../rule.schema.json",
    "engine": "python",
    "find": {
        "select": "assignment",
        "where": [
            {"of": "parent", "extendsAny": "Module"},
            {"any": [
                {"of": "child:value", "kind": "Tuple"},
                {"all": [{"name": "bindings"}, {"of": "child:value", "kind": "List"}]}
            ]}
        ]
    },
    "sin": {
        "name": "module-registration",
        "description": "A module registration is a tuple or its bindings are a list.",
        "rule": "Declare registrations as lists and bindings as a dictionary.",
        "skill": "module-registration"
    }
}
