{
    "$schema": "../rule.schema.json",
    "engine": "python",
    "find": {
        "select": "import",
        "where": [
            {
                "fileMatches": "src/(engine/provider|core/modules/[a-z_]+/providers)/"
            },
            {
                "any": [
                    {
                        "nameMatches": "(\\.guards?(\\.|$)|\\.policies(\\.|$)|agent_machine\\.contracts\\.(policy|event_policy)|rule_answer|hook_reply)"
                    },
                    {
                        "descendant": {
                            "resolvesLike": "*.guards.*"
                        }
                    },
                    {
                        "descendant": {
                            "resolvesLike": "*.policies.*"
                        }
                    }
                ]
            }
        ],
        "reject": [
            {
                "testCode": true
            }
        ]
    },
    "sin": {
        "name": "provider-decides-what-an-agent-may-do",
        "description": "A provider imports a guard, a policy or the hook's answer, so what an agent may do is decided in the code that only speaks the program's language.",
        "rule": "A provider reads and writes its program's files and lines; what the agent may do is the agent machine's policies' and the guards' to decide.",
        "skill": "providers-architecture"
    }
}
