#include <tunables/global>

# The agent daemon (rootless Docker in a container) on a host that restricts unprivileged user namespaces, such as
# Ubuntu 24.04 and later: it may make the user namespace rootlesskit needs and otherwise runs as an unconfined one.
profile journal-agent-daemon flags=(attach_disconnected,mediate_deleted) {
  #include <abstractions/base>

  network,
  capability,
  file,
  umount,
  userns,
  mount,
  pivot_root,
  signal,
  ptrace,
  unix,
}
