{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "laravel/vue-starter-kit",
    "type": "project",
    "description": "The skeleton application for the Laravel framework.",
    "keywords": [
        "laravel",
        "framework"
    ],
    "license": "FSL-1.1-ALv2",
    "require": {
        "php": "^8.6",
        "brick/math": "^1.0",
        "inertiajs/inertia-laravel": "^3.0",
        "laravel/chisel": "^0.1.0",
        "laravel/fortify": "^1.37.2",
        "laravel/framework": "^13.17",
        "laravel/mcp": "^1.2",
        "laravel/octane": "^2.24",
        "laravel/reverb": "^1.0",
        "laravel/tinker": "^3.0",
        "laravel/wayfinder": "^0.1.14",
        "league/commonmark": "^2.10",
        "phpoption/phpoption": "^1.10",
        "spatie/laravel-data": "^4.23",
        "spatie/laravel-typescript-transformer": "^3.0",
        "symfony/yaml": "^8.1"
    },
    "require-dev": {
        "barryvdh/laravel-ide-helper": "*",
        "brianium/paratest": "^7.30",
        "fakerphp/faker": "^1.24",
        "friendsofphp/php-cs-fixer": "^3.95",
        "larastan/larastan": "^3.9",
        "laravel/boost": "^2.10",
        "laravel/pail": "^1.2.5",
        "laravel/pao": "^1.0.6",
        "laravel/pint": "^1.27",
        "laravel/sail": "^1.53",
        "mockery/mockery": "^1.6",
        "nikic/php-parser": "^5.9",
        "nunomaduro/collision": "^8.9.3",
        "phpstan/phpdoc-parser": "^2.4",
        "phpunit/phpunit": "^13.4.8"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Domain\\Plans\\Database\\Factories\\": "domain/Plans/database/factories/",
            "Domain\\Plans\\Database\\Seeders\\": "domain/Plans/database/seeders/",
            "Domain\\Tasks\\Database\\Factories\\": "domain/Tasks/database/factories/",
            "Domain\\Tasks\\Database\\Seeders\\": "domain/Tasks/database/seeders/",
            "Domain\\Chat\\": "domain/Chat/src/",
            "Domain\\Documents\\": "domain/Documents/src/",
            "Domain\\Documents\\Database\\Factories\\": "domain/Documents/database/factories/",
            "Domain\\Documents\\Database\\Seeders\\": "domain/Documents/database/seeders/",
            "Domain\\Helpers\\": "domain/Helpers/src/",
            "Domain\\Memory\\": "domain/Memory/src/",
            "Domain\\Plans\\": "domain/Plans/src/",
            "Domain\\Comments\\": "domain/Comments/src/",
            "Domain\\Questions\\": "domain/Questions/src/",
            "Domain\\Reminders\\": "domain/Reminders/src/",
            "Domain\\Rules\\": "domain/Rules/src/",
            "Domain\\Sequences\\": "domain/Sequences/src/",
            "Domain\\Sharing\\": "domain/Sharing/src/",
            "Domain\\Sequences\\Database\\Seeders\\": "domain/Sequences/database/seeders/",
            "Domain\\Tasks\\": "domain/Tasks/src/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Domain\\Chat\\Tests\\": "domain/Chat/tests/",
            "Domain\\Comments\\Tests\\": "domain/Comments/tests/",
            "Domain\\Questions\\Tests\\": "domain/Questions/tests/",
            "Domain\\Reminders\\Tests\\": "domain/Reminders/tests/",
            "Domain\\Documents\\Tests\\": "domain/Documents/tests/",
            "Domain\\Plans\\Tests\\": "domain/Plans/tests/",
            "Domain\\Rules\\Tests\\": "domain/Rules/tests/",
            "Domain\\Sequences\\Tests\\": "domain/Sequences/tests/",
            "Domain\\Sharing\\Tests\\": "domain/Sharing/tests/",
            "Domain\\Helpers\\Tests\\": "domain/Helpers/tests/",
            "Domain\\Memory\\Tests\\": "domain/Memory/tests/",
            "Domain\\Tasks\\Tests\\": "domain/Tasks/tests/",
            "Tests\\Fixtures\\Modules\\Cards\\": "tests/Fixtures/Modules/Cards/src/",
            "Tests\\Fixtures\\Modules\\Handbook\\": "tests/Fixtures/Modules/Handbook/src/",
            "Tests\\Fixtures\\Modules\\Ledger\\": "tests/Fixtures/Modules/Ledger/src/",
            "Tests\\Fixtures\\Modules\\Notes\\": "tests/Fixtures/Modules/Notes/src/",
            "Tests\\": "tests/",
            "Tools\\InstallationChecks\\": "tools/installation-checks/src/",
            "Tools\\CodeStyle\\": "tools/code-style/",
            "Tools\\ModelDocs\\": "tools/model-docs/"
        }
    },
    "scripts": {
        "setup": [
            "composer install",
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\"",
            "@php artisan key:generate",
            "@php artisan migrate --force",
            "@php artisan numbers:install",
            "@php artisan skill:refresh",
            "@php artisan agents:install",
            "npm install",
            "@types:generate",
            "npm run build"
        ],
        "dev": [
            "Composer\\Config::disableProcessTimeout",
            "@php artisan dev"
        ],
        "lint": [
            "pint --parallel",
            "php-cs-fixer fix --quiet --config=tools/code-style/php-cs-fixer.php"
        ],
        "lint:check": [
            "pint --parallel --test",
            "php-cs-fixer check --config=tools/code-style/php-cs-fixer.php"
        ],
        "ci:check": [
            "Composer\\Config::disableProcessTimeout",
            "@types:generate",
            "npm run check",
            "npm run types:check",
            "@test"
        ],
        "api:generate": "@php artisan journal:api",
        "api:check": "@php artisan journal:api --check",
        "types:generate": [
            "@php -d memory_limit=512M artisan typescript:transform"
        ],
        "models:docs": [
            "@php -d memory_limit=1G artisan ide-helper:models --write --reset --no-interaction"
        ],
        "types:check": [
            "phpstan analyse --memory-limit=1G"
        ],
        "test": [
            "Composer\\Config::disableProcessTimeout",
            "@php tests/bin/in-docker.php test:inside"
        ],
        "test:inside": [
            "Composer\\Config::disableProcessTimeout",
            "@php artisan config:clear --ansi",
            "@lint:check",
            "@types:check",
            "@php artisan test --parallel --recreate-databases"
        ],
        "test:run": [
            "Composer\\Config::disableProcessTimeout",
            "@php tests/bin/in-docker.php test:run-inside"
        ],
        "test:run-inside": [
            "Composer\\Config::disableProcessTimeout",
            "@php tests/bin/run-tests.php"
        ],
        "installation-checks": [
            "Composer\\Config::disableProcessTimeout",
            "php tools/installation-checks/run.php"
        ],
        "test:affected": [
            "Composer\\Config::disableProcessTimeout",
            "@php tests/bin/in-docker.php test:affected-inside"
        ],
        "test:affected-inside": [
            "Composer\\Config::disableProcessTimeout",
            "@php tests/bin/affected-tests.php"
        ],
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force",
            "@php vendor/bin/commandments sync"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi",
            "@php -r \"file_exists('database/database.sqlite') || touch('database/database.sqlite');\"",
            "@php artisan migrate --graceful --ansi"
        ],
        "pre-package-uninstall": [
            "Illuminate\\Foundation\\ComposerScripts::prePackageUninstall"
        ],
        "post-install-cmd": [
            "@php vendor/bin/commandments sync",
            "git config core.hooksPath .githooks 2>/dev/null || true"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": [],
            "installer": {
                "post-create-project": []
            }
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
