includes:
    - vendor/larastan/larastan/extension.neon
    - vendor/nesbot/carbon/extension.neon

parameters:
    # Laravel Data's collection keeps the list a JSON column holds a list.
    stubFiles:
        - stubs/laravel-data/DataCollection.stub
    # Each checkout keeps its own result cache: the main checkout and the workers' worktrees run in one container, and
    # one shared cache under /tmp was corrupted by their runs at once.
    tmpDir: %currentWorkingDirectory%/storage/framework/cache/phpstan
    paths:
        - app/
        - domain/
        - bootstrap/app.php
        - config/
        - database/
        - routes/
        - bootstrap/domains.php
        - tests/Architecture/
        - tests/Fixtures/

    # A domain's tests, like the tests in tests/Feature and tests/Unit, are not analysed.
    excludePaths:
        - domain/*/tests/*
        # The attribute rules' own fixtures break the rules on purpose; their tests analyse them alone.
        - tests/Fixtures/PhpStan/*
        # The static factory scan's fixture repeats calls and passes loose names on purpose; StaticFactoryScanTest reads it.
        - tests/Fixtures/StaticFactories/*
        # The core domain text fixture is a small project tree read as text; CoreNamesNoDomainTest reads it.
        - tests/Fixtures/CoreDomainText/*
        # The nested call fixture is read as a syntax tree only; NestedCallsTest reads it.
        - tests/Fixtures/NestedCalls/*
        # The affected tests' fixture is a small code tree read only for its syntax; AffectedTestsTest reads it.
        - tests/Fixtures/AffectedTests/*
        # The state return check's fixture answers with arrays on purpose; StateReturnsTest reads it.
        - tests/Fixtures/StateReturns/*
        # These fixtures break one code rule each on purpose, and the architecture test of that rule reads them.
        - tests/Fixtures/TestOverlap/*
        - tests/Fixtures/ArrayLines/*
        - tests/Fixtures/SingleKeySpreads/*
        - tests/Fixtures/ArrayCasts/*
        - tests/Fixtures/ModelAccessors/*
        - tests/Fixtures/ModelSections/*
        - tests/Fixtures/ArrayWrites/*

    level: 7

rules:
    - Tests\Architecture\PhpStan\TypedClassConstantRule
    - Tests\Architecture\PhpStan\RawReflectionRule
    - Tests\Architecture\PhpStan\ActorReferenceCopyRule

services:
    # A ThrowingCall's next call answers a closure that throws, not the exception its @mixin names.
    -
        class: Tests\Architecture\PhpStan\ThrowingCallMethods
        tags:
            - phpstan.broker.methodsClassReflectionExtension
