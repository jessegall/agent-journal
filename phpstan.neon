includes:
    - vendor/larastan/larastan/extension.neon
    - vendor/nesbot/carbon/extension.neon

parameters:
    paths:
        - app/
        - domain/
        - bootstrap/app.php
        - config/
        - database/
        - routes/
        - bootstrap/domains.php
        - tests/Architecture/
        - tests/Fixtures/

    # A domain's tests, like the tests in tests/Feature and tests/Unit, are not analysed.
    excludePaths:
        - domain/*/tests/*

    level: 7

rules:
    - Tests\Architecture\PhpStan\TypedClassConstantRule
