includes:
    - vendor/larastan/larastan/extension.neon
    - vendor/nesbot/carbon/extension.neon

parameters:
    # Each checkout keeps its own result cache: the main checkout and the workers' worktrees run in one container, and
    # one shared cache under /tmp was corrupted by their runs at once.
    tmpDir: %currentWorkingDirectory%/storage/framework/cache/phpstan
    paths:
        - app/
        - domain/
        - bootstrap/app.php
        - config/
        - database/
        - routes/
        - bootstrap/domains.php
        - tests/Architecture/
        - tests/Fixtures/

    # A domain's tests, like the tests in tests/Feature and tests/Unit, are not analysed.
    excludePaths:
        - domain/*/tests/*
        # The attribute rules' own fixtures break the rules on purpose; their tests analyse them alone.
        - tests/Fixtures/PhpStan/*

    level: 7

rules:
    - Tests\Architecture\PhpStan\TypedClassConstantRule
    - Tests\Architecture\PhpStan\StandaloneAttributeRule
    - Tests\Architecture\PhpStan\AttributeOrderRule
    - Tests\Architecture\PhpStan\RawReflectionRule
