{
    "about": "Host protocol 1 between the Go host and the PHP journal, written once. php artisan journal:host-protocol generates the Go and PHP code from this file; never edit the generated files.",
    "version": 1,
    "statuses": {
        "done": "the host carried the order out",
        "refused": "the host did not carry the order out, for the refusal it names"
    },
    "refusals": {
        "guard_moved": "the screen rows or input generation the order was guarded by have moved on",
        "not_running": "the process the order is for is not running",
        "expired": "the order arrived past its expiry",
        "unsafe": "the order is unsigned, altered, or names something the host may not do",
        "host_restarted": "the host restarted while carrying the order out, and the order may not run twice",
        "fenced": "a newer generation of the process fences the order out",
        "unknown_order": "this host does not carry out the order's type"
    },
    "orders": {
        "open_container": { "scope": "process", "process_type": "any", "opens": true, "payload": "open_plan" },
        "open_process": { "scope": "process", "process_type": "any", "opens": true, "payload": "open_plan" },
        "write_keys": { "scope": "process", "process_type": "terminal", "is_input": true, "payload": "key_write" },
        "write_stdin": { "scope": "process", "process_type": "pipe", "is_input": true, "payload": "stdin_write" },
        "close_stdin": { "scope": "process", "process_type": "pipe", "is_input": true, "is_repeatable": true, "payload": null },
        "open_private": { "scope": "process", "process_type": "any", "payload": null },
        "write_private": { "scope": "process", "process_type": "any", "is_input": true, "payload": "private_write" },
        "close_private": { "scope": "process", "process_type": "any", "payload": null },
        "resize": { "scope": "process", "process_type": "terminal", "is_repeatable": true, "payload": "terminal_size" },
        "signal": { "scope": "process", "process_type": "any", "payload": "signal_plan" },
        "stop": { "scope": "process", "process_type": "any", "ends_process": true, "is_repeatable": true, "payload": "stop_plan" },
        "stream": { "scope": "process", "process_type": "terminal", "is_repeatable": true, "payload": "stream_plan" },
        "snapshot": { "scope": "process", "process_type": "terminal", "is_repeatable": true, "payload": null },
        "run_fenced": { "scope": "process", "process_type": "any", "payload": "fenced_plan" },
        "allow_images": { "scope": "host", "process_type": "any", "offered_again_after_restart": false, "payload": "images_plan" },
        "make_folder": { "scope": "host", "process_type": "any", "is_repeatable": true, "payload": "folder_plan" },
        "remove_folder": { "scope": "host", "process_type": "any", "is_repeatable": true, "payload": "folder_plan" },
        "folder_use": { "scope": "host", "process_type": "any", "is_repeatable": true, "payload": "folder_plan" },
        "remove": { "scope": "host", "process_type": "any", "ends_process": true, "is_repeatable": true, "payload": "remove_plan" },
        "read_project": { "scope": "process", "process_type": "any", "is_repeatable": true, "payload": "project_read" },
        "record": { "scope": "process", "process_type": "any", "payload": null },
        "stop_recording": { "scope": "process", "process_type": "any", "is_repeatable": true, "payload": null },
        "upgrade": { "scope": "host", "process_type": "any", "payload": "upgrade_plan" }
    },
    "placeholder_kinds": [
        "folder",
        "host"
    ],
    "host_names": [
        "JOURNAL_URL",
        "INSTALLATION",
        "HOOK_COMMAND",
        "JOURNAL_AGENT"
    ],
    "contained_plan": {
        "about": "A contained plan names nothing of the host it runs on: no host placeholder and none of these fields.",
        "refused_fields": [
            "folders",
            "side_sockets",
            "read_files",
            "inherit"
        ]
    },
    "programs": {
        "journal-hook": {
            "about": "The native hook adapter a driver runs on every hook event.",
            "arguments": [
                "driver",
                "reply file"
            ]
        }
    },
    "types": {
        "order": { "id": "string", "sequence": "uint64", "type": "string", "process_id": "string", "payload": "string", "expires_at": "time", "signature": "string" },
        "claimed_orders": { "orders": "list<order>", "idle_window_s": "int", "now": "time" },
        "answer": { "order_id": "string", "status": "status", "refusal": "refusal?", "facts": "map<any>?" },
        "process_report": { "process_id": "string", "report": "string", "identity": "string?", "generation": "int", "exit_code": "int?", "signal": "string?", "evidence": "string?" },
        "output": { "frames": "list<frame>", "chunks": "list<chunk>" },
        "frame": { "rows": "list<string>", "cursor_row": "int", "cursor_column": "int", "columns": "int", "buffer": "string", "captured": "int64", "unchanged_ms": "list<int64>", "title": "string?", "is_shielded": "bool" },
        "chunk": { "stream": "string", "offset": "int64", "bytes": "string" },
        "inventory": { "protocol": "int", "release": "string", "answered_through": "string?", "capabilities": "list<string>", "processes": "list<inventory_process>" },
        "inventory_process": { "process_id": "string", "identity": "string", "container": "string?", "is_alive": "bool", "is_terminal_held": "bool", "spool_offset": "int64" },
        "host_heartbeat": { "live_processes": "list<string>", "answered_through": "string?" },
        "private_value": { "value": "string" },
        "project_read_report": { "entries": "list<project_entry>?", "text": "string?", "digest": "string?", "size": "int64?", "truncated": "bool", "failure": "string?" },
        "project_entry": { "name": "string", "is_folder": "bool", "size": "int64" },
        "open_plan": { "type": "process_type", "restart": "string", "argv": "list<string>", "restart_argv": "list<string>", "restart_when_file": "restart_file|null", "environment": "list<string>", "folder": "string", "container": "container_manifest|null", "labels": "start_labels|null", "size": "terminal_size", "files": "list<plan_file>", "folders": "list<string>", "inherit": "list<string>", "side_sockets": "list<string>", "read_files": "list<string>?", "shield_rules": "list<shield_rule>?", "fence": "string?", "kept_files": "list<string>?" },
        "terminal_size": { "columns": "uint16", "rows": "uint16" },
        "restart_file": { "folder": "string", "glob": "string" },
        "start_labels": { "installation": "string", "session": "string", "account": "string" },
        "plan_file": { "name": "string", "content": "string", "template": "bool" },
        "shield_rule": { "keywords": "list<string>", "min_keywords": "int" },
        "container_manifest": { "image": "string", "user": "string", "workdir": "string", "isReadOnlyRoot": "bool", "capabilities": "list<string>", "blocksNewPrivileges": "bool", "isPrivileged": "bool", "network": "string", "mounts": "list<container_mount>", "publishedPorts": "list<int>", "budgets": "container_budgets", "securityOptions": "security_options", "isAttachable": "bool", "workspacePreparation": "workspace_preparation|null", "startProfile": "string", "entrypoint": "string" },
        "container_mount": { "type": "string", "source": "string", "target": "string", "isWritable": "bool", "mustExist": "bool", "isCheckout": "bool" },
        "container_budgets": { "cpuCores": "int", "memoryBytes": "int", "memorySwapBytes": "int", "processes": "int", "openFiles": "int", "tmpBytes": "int", "homeBytes": "int", "workspaceBytes": "int" },
        "security_options": { "seccomp": "string", "apparmor": "string" },
        "workspace_preparation": { "clone": "workspace_clone|null", "folder": "string" },
        "workspace_clone": { "volume": "string", "repository": "string", "revision": "string", "deployKeySecret": "string" },
        "key_write": { "bytes": "bytes", "if_rows": "row_guard|null", "if_input_generation": "uint64|null", "as_user": "bool" },
        "row_guard": { "from": "int", "to": "int", "hash": "string" },
        "stdin_write": { "bytes": "bytes" },
        "private_write": { "submission": "string" },
        "stream_plan": { "frames_per_second": "int", "raw": "bool" },
        "signal_plan": { "signal": "string" },
        "stop_plan": { "grace_ms": "int", "force_ms": "int" },
        "remove_plan": { "container": "string", "network": "string", "session": "string" },
        "fenced_plan": { "fence": "string", "waiting": "list<string>", "budget_ms": "int", "runs": "list<fenced_run>" },
        "fenced_run": { "argv": "list<string>", "folder": "string", "deadline_ms": "int", "output_limit": "int" },
        "images_plan": { "images": "list<string>" },
        "folder_plan": { "folder": "string", "operation": "string" },
        "project_read": { "id": "string", "binding_id": "string", "type": "string", "path": "string", "entries_limit": "int", "text_limit": "int" },
        "upgrade_plan": { "version": "string", "manifest": "string", "signature": "string", "drivers": "string" }
    },
    "calls": {
        "claim_orders": { "path": "/host/orders/claim", "query": { "limit": "int", "wait": "int" }, "body": null, "reply": "claimed_orders" },
        "answer_order": { "path": "/host/orders/{order}", "body": "answer", "reply": null },
        "pull_private_value": { "path": "/host/private-values/{submission}", "body": null, "reply": "private_value" },
        "notify_process_output": { "path": "/host/processes/{process}/output", "body": "output", "reply": null },
        "notify_process_report": { "path": "/host/processes/{process}", "body": "process_report", "reply": null },
        "notify_inventory": { "path": "/host/inventory", "body": "inventory", "reply": null },
        "notify_heartbeat": { "path": "/host/heartbeat", "body": "host_heartbeat", "reply": null },
        "notify_project_read": { "path": "/host/reports/project-reads/{read}", "body": "project_read_report", "reply": null }
    }
}
