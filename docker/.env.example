# Copy to .env and keep it readable by you alone: chmod 600 .env

# The server's own domain; its DNS record points at this server.
JOURNAL_ADDRESS=journal.example.com

# The project the journal works on, cloned into the volume on the first start.
GIT_REPOSITORY=https://github.com/you/your-project.git
# A fine-grained GitHub token that may push to that repository; agents push their branches with it.
GITHUB_TOKEN=
GIT_NAME=Journal on a server
GIT_EMAIL=journal@example.com

# The provider login server agents run on: a token from `claude setup-token` on your own machine, or an API key.
CLAUDE_CODE_OAUTH_TOKEN=
ANTHROPIC_API_KEY=

# Backups: a password for the restic repository, kept somewhere other than this server too.
RESTIC_PASSWORD=
# RESTIC_REPOSITORY=s3:s3.amazonaws.com/your-bucket/journal
