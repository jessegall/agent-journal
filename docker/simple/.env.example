# The login Caddy asks for in front of the journal.
JOURNAL_USER=jesse
JOURNAL_PASSWORD=

# The server's domain: Caddy fetches its certificate and serves https. Leave it empty for plain http on port 80.
JOURNAL_ADDRESS=

# The project the journal works on: cloned into the volume on the first start. Leave it empty for an empty project.
GIT_REPOSITORY=
# A fine-grained token that may push to the repository, for a private repository or for pushing at all.
GITHUB_TOKEN=
GIT_NAME=Journal on a server
GIT_EMAIL=journal@example.com

# Claude Code's login: a token from `claude setup-token` on your own machine (your subscription),
# or an API key (paid per use). One of the two is enough.
CLAUDE_CODE_OAUTH_TOKEN=
ANTHROPIC_API_KEY=
