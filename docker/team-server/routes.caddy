# The team server's paths go to the sync server, the hooks and the CLI to no one, and every other path to the hosted journal.
@sync path /login /accept /push /pull /copy /blocks /invite /devices /devices/* /people/* /upload /upgrade /team /team/* /files/* /leases /leases/*
handle @sync {
	reverse_proxy 127.0.0.1:8470
}
@closed path /hooks/* /cli /cli/* /shell/*
handle @closed {
	respond 404
}
handle {
	reverse_proxy 127.0.0.1:8421 {
		flush_interval -1
	}
}
# The hosted journal starts only once the first journal has joined this server; until then its paths say so.
handle_errors 502 {
	respond "The team's journal opens here once the first journal has joined this server: run the join line the setup printed from your own journal." 503
}
