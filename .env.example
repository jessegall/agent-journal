APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:54700

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=journal
DB_USERNAME=journal
DB_PASSWORD=secret

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Reverb, server side: how the app and the queue worker reach the reverb container, and its credentials. Secret.
# Generate the id, key and secret once, for example with php artisan reverb:install, and never put the secret in a VITE_ value.
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST=reverb
REVERB_PORT=8080
REVERB_SCHEME=http
# The hosts browsers may connect from, comma separated.
REVERB_ALLOWED_ORIGINS=localhost,127.0.0.1

# Reverb, browser side: public values only, built into the JavaScript. The browser reaches Reverb on the forwarded port;
# in production use the public host, port 443 and https behind the proxy that ends TLS.
VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST=localhost
VITE_REVERB_PORT=54704
VITE_REVERB_SCHEME=http

OCTANE_SERVER=frankenphp

# The users id of the one person who may use the journal; unset means nobody may (config/access.php).
JOURNAL_OWNER_EMAIL=

# Local development only: the sign-in form opens with this account filled in. Leave empty elsewhere.
LOCAL_SIGN_IN_EMAIL=owner@journal.local
LOCAL_SIGN_IN_PASSWORD=password

# The contained profile (docker compose --profile contained, doc 61); the Mac's local arrangement needs none of these.
# The image of the separate Docker daemon that holds only agent containers: rootless Docker-in-Docker by default.
AGENT_DAEMON_IMAGE=docker:28-dind-rootless
# The container runtime for that daemon: runc with the relaxed profiles, or sysbox-runc where the server has Sysbox.
AGENT_DAEMON_RUNTIME=runc
# Where that daemon keeps its data: the rootless image's home folder by default; /var/lib/docker for a rootful image
# (docker:28-dind under sysbox-runc, which gives the daemon its own cgroups so agent budgets hold).
# AGENT_DAEMON_DATA=/var/lib/docker
# The agent image every agent runs in, by digest, as .docker/helper/build.sh records it in
# docs/accounts/docker-images.json.
AGENT_IMAGE=
# The runner image for agent-host, agent-host-enroll and accounts, by digest, recorded the same way.
RUNNER_IMAGE=
# Where agents run: local on this machine (the default), or contained in the agent daemon's containers.
AGENTS_ARRANGEMENT=local
# The host id agents:host-enroll --contained printed; its secret goes in secrets/journal_host_secret, never here.
AGENTS_HOST_ID=
# The prefix of this journal's containers, networks and volumes on the agent daemon.
AGENTS_INSTALLATION_NAME=journal
# Contained only: the accounts volume's one path, where the sign-in service and the agent daemon mount it; the
# journal names each sign-in's folder under it. Unset, the root is storage/app/private/accounts.
# ACCOUNTS_ROOT=/srv/journal/accounts
# Hosts that restrict unprivileged user namespaces (Ubuntu 24.04+) load .docker/helper/apparmor-agent-daemon and name it.
# AGENT_DAEMON_APPARMOR=journal-agent-daemon
# Contained only: the server folder holding one workspace folder per environment, owned by uid 10001; unset, none.
# AGENTS_WORKSPACES_FOLDER=/srv/workspaces
# Contained only: each environment's workspace, from Git (its deploy key a compose secret) or a folder in the one above.
# AGENTS_WORKSPACES={"main":{"git":"git@github.com:acme/shop.git","revision":"main","deploy_key_secret":"deploy_key_main"}}
# The allow-list proxy the sign-in service goes out through; pin it by digest (name@sha256:...) once pulled.
EGRESS_PROXY_IMAGE=ubuntu/squid:6.13-25.04_beta
