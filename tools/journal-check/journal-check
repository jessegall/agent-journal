#!/usr/bin/env php
<?php

declare(strict_types=1);

/*
 * journal-check: the protected stop checks a helper's work must pass before it may finish. It boots no application
 * and changes nothing: it never commits, stashes, resets or deletes. Installed at /opt/journal/bin/journal-check.
 *
 * worktree-clean: exit 0 only when the assigned workspace has nothing uncommitted and no repository state that hides
 * work; otherwise exit 1 with a short summary. The workspace is never an argument: it is /workspace in the container,
 * or the path the protected host sets in JOURNAL_CHECK_WORKSPACE. A clean worktree does not prove the committed code
 * is safe or correct; it only proves that nothing was left uncommitted.
 */

const WORKSPACE = '/workspace';
const MOST_PATHS = 5;

exit(main($argv));

/**
 * @param  list<string>  $arguments
 */
function main(array $arguments): int
{
    if (($arguments[1] ?? '') !== 'worktree-clean' || count($arguments) !== 2) {
        fwrite(STDERR, "Usage: journal-check worktree-clean\nChecks that the assigned workspace has nothing uncommitted. A clean worktree does not prove the committed code is safe.\n");

        return 2;
    }

    $problems = worktreeProblems(workspace());

    if ($problems === []) {
        fwrite(STDOUT, "The worktree is clean.\n");

        return 0;
    }

    fwrite(STDOUT, implode("\n", array_slice($problems, 0, 8))."\n");

    return 1;
}

function workspace(): string
{
    $hostWorkspace = getenv('JOURNAL_CHECK_WORKSPACE');

    return is_string($hostWorkspace) && $hostWorkspace !== '' ? $hostWorkspace : WORKSPACE;
}

/**
 * @return list<string>
 */
function worktreeProblems(string $workspace): array
{
    [$inside, $insideCode] = git($workspace, ['rev-parse', '--is-inside-work-tree']);

    if ($insideCode !== 0 || trim($inside) !== 'true') {
        return ["{$workspace} is not a git worktree, or git could not read it."];
    }

    [$gitDirectory] = git($workspace, ['rev-parse', '--absolute-git-dir']);
    $problems = operationsInProgress(trim($gitDirectory));

    [$branch, $branchCode] = git($workspace, ['symbolic-ref', '-q', '--short', 'HEAD']);
    $expected = getenv('JOURNAL_CHECK_BRANCH');

    if ($branchCode !== 0) {
        $problems[] = 'HEAD is detached: work must sit on the assigned branch.';
    } elseif (is_string($expected) && $expected !== '' && trim($branch) !== $expected) {
        $problems[] = 'The worktree is on branch '.trim($branch).", not the assigned {$expected}.";
    }

    [$status, $statusCode] = git($workspace, ['status', '--porcelain=v1', '-z', '--untracked-files=all', '--ignore-submodules=none']);

    if ($statusCode !== 0) {
        return [...$problems, 'git status failed in the worktree.'];
    }

    array_push($problems, ...statusProblems($status));
    array_push($problems, ...hiddenPaths($workspace));

    return $problems;
}

/**
 * @return list<string>
 */
function operationsInProgress(string $gitDirectory): array
{
    $markers = ['MERGE_HEAD' => 'a merge', 'CHERRY_PICK_HEAD' => 'a cherry-pick', 'REVERT_HEAD' => 'a revert', 'rebase-merge' => 'a rebase', 'rebase-apply' => 'a rebase'];
    $problems = [];

    foreach ($markers as $marker => $operation) {
        if (file_exists("{$gitDirectory}/{$marker}")) {
            $problems[] = "{$operation} is in progress: finish or abort it.";
        }
    }

    return array_values(array_unique($problems));
}

/**
 * What git status reports, grouped by kind, each naming at most a few paths.
 *
 * @return list<string>
 */
function statusProblems(string $status): array
{
    $groups = ['conflict' => [], 'staged' => [], 'deleted' => [], 'modified' => [], 'untracked' => []];
    $entries = array_values(array_filter(explode("\0", $status), fn (string $entry): bool => $entry !== ''));

    for ($index = 0; $index < count($entries); $index++) {
        $entry = $entries[$index];
        $code = substr($entry, 0, 2);
        $path = substr($entry, 3);

        if ($code[0] === 'R' || $code[0] === 'C') {
            $index++;
        }

        $group = match (true) {
            $code === '??' => 'untracked',
            str_contains($code, 'U') || $code === 'AA' || $code === 'DD' => 'conflict',
            $code[1] === 'D' => 'deleted',
            $code[0] !== ' ' => 'staged',
            default => 'modified',
        };
        $groups[$group][] = $path;
    }

    $labels = ['conflict' => 'Conflicted', 'staged' => 'Staged but not committed', 'deleted' => 'Deleted tracked file', 'modified' => 'Changed and not committed', 'untracked' => 'Untracked'];
    $problems = [];

    foreach ($groups as $group => $paths) {
        if ($paths !== []) {
            $problems[] = $labels[$group].': '.namedPaths($paths);
        }
    }

    return $problems;
}

/**
 * Tracked files git is told to skip or assume unchanged, which status would never show.
 *
 * @return list<string>
 */
function hiddenPaths(string $workspace): array
{
    [$listing, $code] = git($workspace, ['ls-files', '-v', '-z']);

    if ($code !== 0) {
        return ['git could not list the tracked files.'];
    }

    $hidden = [];

    foreach (array_filter(explode("\0", $listing), fn (string $entry): bool => $entry !== '') as $entry) {
        $tag = $entry[0];

        if ($tag === 'S' || ctype_lower($tag)) {
            $hidden[] = substr($entry, 2);
        }
    }

    return $hidden === [] ? [] : ['Marked skip-worktree or assume-unchanged: '.namedPaths($hidden)];
}

/**
 * @param  list<string>  $paths
 */
function namedPaths(array $paths): string
{
    $named = implode(', ', array_slice($paths, 0, MOST_PATHS));
    $more = count($paths) - MOST_PATHS;

    return $more > 0 ? "{$named} and {$more} more" : $named;
}

/**
 * Runs git as argv with a sanitized environment and configuration: no system or global config, no hooks, no optional
 * locks, no external diff and no credential helper.
 *
 * @param  list<string>  $arguments
 * @return array{0: string, 1: int}
 */
function git(string $workspace, array $arguments): array
{
    $emptyHooks = sys_get_temp_dir().'/journal-check-no-hooks';

    if (! is_dir($emptyHooks)) {
        mkdir($emptyHooks, 0700, true);
    }

    $command = ['git', '-C', $workspace, '-c', "core.hooksPath={$emptyHooks}", '-c', 'credential.helper=', '-c', 'diff.external=', '-c', 'core.fsmonitor=false', ...$arguments];
    $environment = ['PATH' => '/usr/local/bin:/usr/bin:/bin', 'HOME' => sys_get_temp_dir(), 'GIT_CONFIG_NOSYSTEM' => '1', 'GIT_CONFIG_GLOBAL' => '/dev/null', 'GIT_OPTIONAL_LOCKS' => '0', 'GIT_TERMINAL_PROMPT' => '0', 'LC_ALL' => 'C'];
    $process = proc_open($command, [1 => ['pipe', 'w'], 2 => ['pipe', 'w']], $pipes, null, $environment);

    if (! is_resource($process)) {
        return ['', 127];
    }

    $output = (string) stream_get_contents($pipes[1]);
    fclose($pipes[1]);
    fclose($pipes[2]);

    return [$output, proc_close($process)];
}
