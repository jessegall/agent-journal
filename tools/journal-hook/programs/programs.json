{
  "events": [
    "pre_tool_use",
    "post_tool_use",
    "post_tool_use_failure",
    "prompt",
    "stop",
    "stop_failure",
    "session_start",
    "session_end",
    "compact",
    "message_display"
  ],
  "programs": {
    "claude": {
      "decoder": "common",
      "events": {
        "MessageDisplay": "message_display",
        "PostToolUse": "post_tool_use",
        "PostToolUseFailure": "post_tool_use_failure",
        "PreCompact": "compact",
        "PreToolUse": "pre_tool_use",
        "SessionEnd": "session_end",
        "SessionStart": "session_start",
        "Stop": "stop",
        "StopFailure": "stop_failure",
        "UserPromptSubmit": "prompt"
      },
      "line_events": [
        "session_start",
        "prompt",
        "pre_tool_use",
        "post_tool_use"
      ],
      "plain_output_events": [
        "session_start",
        "prompt"
      ],
      "matchers": {
        "PostToolUse": "tool_name",
        "PostToolUseFailure": "tool_name",
        "PreCompact": "trigger",
        "PreToolUse": "tool_name",
        "SessionEnd": "reason",
        "SessionStart": "source"
      },
      "refusals": {
        "pre_tool_use": "deny",
        "prompt": "block",
        "stop": "block"
      },
      "rewrites": {
        "pre_tool_use": {
          "run_in_background": false
        }
      },
      "tool_categories": {
        "Agent": "agent",
        "AskUserQuestion": "question",
        "Bash": "shell",
        "Edit": "edit",
        "Glob": "search",
        "Grep": "search",
        "Monitor": "monitor",
        "MultiEdit": "edit",
        "NotebookEdit": "edit",
        "Read": "read",
        "Skill": "read",
        "Task": "agent",
        "ToolSearch": "search",
        "Write": "write"
      }
    },
    "codex": {
      "decoder": "codex",
      "events": {
        "PostToolUse": "post_tool_use",
        "PreCompact": "compact",
        "PreToolUse": "pre_tool_use",
        "SessionEnd": "session_end",
        "SessionStart": "session_start",
        "Stop": "stop",
        "UserPromptSubmit": "prompt"
      },
      "line_events": [
        "session_start",
        "prompt",
        "pre_tool_use",
        "post_tool_use"
      ],
      "plain_output_events": [
        "session_start",
        "prompt"
      ],
      "matchers": {
        "PostToolUse": "tool_name",
        "PreToolUse": "tool_name",
        "SessionEnd": "reason",
        "SessionStart": "source"
      },
      "refusals": {
        "stop": "block"
      },
      "rewrites": {},
      "tool_categories": {
        "Bash": "shell",
        "apply_patch": "edit",
        "collaborationspawn_agent": "agent",
        "read_file": "read",
        "view_image": "read",
        "request_user_input": "question",
        "write_file": "write"
      }
    }
  }
}
