{
    "name": "documents-reader",
    "width": 1440,
    "height": 900,
    "theme": "dark",
    "pairing": "text",
    "design": {
        "url": "docs/designs/home-v6/index.html",
        "steps": [
            {
                "click": "role=button[name='Documents']"
            },
            {
                "click": "#main .pglist [data-item] >> nth=0"
            }
        ],
        "part": ".reader"
    },
    "app": {
        "url": "http://localhost:54700/login",
        "steps": [
            {
                "login": "owner@journal.local"
            },
            {
                "goto": "http://localhost:54700/documents"
            },
            {
                "click": "li:has(a[data-row-key]):has-text('Design: Home, version 6')"
            }
        ],
        "part": "[data-reader]"
    }
}
