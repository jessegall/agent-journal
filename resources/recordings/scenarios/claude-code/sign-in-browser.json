{
    "description": "A Claude Code sign-in completes in the browser after the user signs in there",
    "steps": [
        {
            "do": "sign-in",
            "driver": "claude-code",
            "method": "oauth"
        },
        {
            "do": "wait-for",
            "fact": "challenge-shown",
            "seconds": 60
        },
        {
            "do": "ask-user",
            "text": "Open the link and sign in; press Enter once the page says you are signed in."
        },
        {
            "do": "wait-for",
            "fact": "signed-in",
            "seconds": 120
        }
    ]
}
