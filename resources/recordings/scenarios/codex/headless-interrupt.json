{
    "description": "A headless Codex turn is interrupted, which ends its codex exec, and the next message resumes its thread in a new process",
    "steps": [
        {
            "do": "restart-host"
        },
        {
            "do": "start-session",
            "agent": "Coder",
            "type": "headless",
            "model": "gpt-6-luna",
            "effort": "low"
        },
        {
            "do": "send-message",
            "agent": "Coder",
            "text": "Count slowly from 1 to 100, one number per line."
        },
        {
            "do": "wait-for",
            "fact": "answering",
            "seconds": 120
        },
        {
            "do": "interrupt",
            "agent": "Coder"
        },
        {
            "do": "wait-for",
            "fact": "interrupted",
            "seconds": 60
        },
        {
            "do": "release-hold",
            "agent": "Coder"
        },
        {
            "do": "send-message",
            "agent": "Coder",
            "text": "Run: ls."
        },
        {
            "do": "wait-for",
            "fact": "turn-ended",
            "seconds": 120
        },
        {
            "do": "stop",
            "agent": "Coder"
        },
        {
            "do": "wait-for",
            "fact": "stopped",
            "seconds": 60
        }
    ]
}
