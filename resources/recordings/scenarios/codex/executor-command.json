{
    "description": "A Codex terminal runs a shell command of the model as the executor's user and stops",
    "steps": [
        {
            "do": "start-session",
            "agent": "Coder",
            "type": "terminal",
            "model": "gpt-6-luna",
            "effort": "low"
        },
        {
            "do": "wait-for",
            "fact": "turn-ended",
            "seconds": 180
        },
        {
            "do": "send-message",
            "agent": "Coder",
            "text": "Run the shell command id -u in your terminal and reply with only the number it printed."
        },
        {
            "do": "wait-for",
            "fact": "turn-ended",
            "seconds": 180
        },
        {
            "do": "stop",
            "agent": "Coder"
        },
        {
            "do": "wait-for",
            "fact": "stopped",
            "seconds": 60
        }
    ]
}
