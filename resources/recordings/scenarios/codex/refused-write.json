{
    "description": "A Codex terminal attempts a shell write and the journal refuses the tool call",
    "steps": [
        {"do": "restart-host"},
        {"do": "start-session", "agent": "Coder", "type": "terminal", "model": "gpt-6-luna", "effort": "low"},
        {"do": "wait-for", "fact": "turn-ended", "seconds": 180},
        {
            "do": "send-message",
            "agent": "Coder",
            "text": "Run: touch /tmp/journal-recording-write. If denied, say so and stop."
        },
        {"do": "wait-for", "fact": "turn-ended", "seconds": 180},
        {"do": "stop", "agent": "Coder"},
        {"do": "wait-for", "fact": "stopped", "seconds": 60},
        {"do": "wait-for", "fact": "instructions-answered", "seconds": 60}
    ]
}
