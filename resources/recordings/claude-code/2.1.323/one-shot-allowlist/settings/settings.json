{
  "permissions": {
    "allow": [
      "Read",
      "Edit",
      "Write",
      "NotebookEdit",
      "Bash(journal:*)",
      "Bash(ls:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)"
    ],
    "deny": [
      "Agent",
      "Task",
      "Workflow",
      "SendMessage",
      "ListAgents",
      "RemoteTrigger",
      "Skill",
      "Bash(claude:*)",
      "Bash(codex:*)",
      "Bash(*claude -p*)",
      "Bash(*codex exec*)"
    ]
  }
}