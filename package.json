{
    "$schema": "https://www.schemastore.org/package.json",
    "private": true,
    "type": "module",
    "scripts": {
        "build": "npm run types:generate && npm run build:frontend",
        "build:frontend": "npm run imports:check && vp build && npm run build:sharing",
        "build:ssr": "npm run types:generate && npm run imports:check && vp build && vp build --ssr",
        "dev": "npm run types:generate && vp dev",
        "check": "npm run types:generate && npm run imports:check && vp check",
        "check:fix": "vp check --fix",
        "types:check": "npm run types:generate && npm run imports:check && vue-tsc --noEmit",
        "imports:check": "node scripts/check-domain-imports.mjs",
        "types:generate": "php artisan journal:ui-manifest && php artisan wayfinder:generate --with-form && php -d memory_limit=512M artisan typescript:transform",
        "build:sharing": "vp build --config vite.sharing.config.ts"
    },
    "dependencies": {
        "@codemirror/autocomplete": "^6.20.4",
        "@codemirror/language": "^6.13.1",
        "@codemirror/lint": "^6.9.8",
        "@codemirror/state": "^6.7.6",
        "@codemirror/view": "^6.43.15",
        "@inertiajs/vite": "^3.0.0",
        "@inertiajs/vue3": "^3.0.0",
        "@laravel/passkeys": "^0.2.0",
        "@lucide/vue": "^1.17.0",
        "@vue-flow/core": "^1.48.2",
        "@vueuse/core": "^12.8.2",
        "class-variance-authority": "^0.7.1",
        "clsx": "^2.1.1",
        "codemirror": "^6.0.2",
        "laravel-echo": "^2.6.3",
        "laravel-vite-plugin": "^3.0.0",
        "pusher-js": "^8.6.0",
        "reka-ui": "^2.9.8",
        "tailwind-merge": "^3.2.0",
        "tailwindcss": "^4.1.1",
        "tw-animate-css": "^1.2.5",
        "vue": "^3.5.13",
        "vue-input-otp": "^0.3.2",
        "vue-sonner": "^2.0.0"
    },
    "devDependencies": {
        "@laravel/vite-plugin-wayfinder": "^0.1.3",
        "@tailwindcss/vite": "^4.1.11",
        "@types/node": "^22.13.5",
        "@vitejs/plugin-vue": "^6.0.0",
        "@vue/test-utils": "^2.6.0",
        "concurrently": "^10.0.3",
        "happy-dom": "^21.0.4",
        "pixelmatch": "^7.1.0",
        "playwright": "^1.57.0",
        "typescript": "^5.2.2",
        "vite": "npm:@voidzero-dev/vite-plus-core@1.4.0",
        "vite-plus": "1.4.0",
        "vue-tsc": "^3.3.13"
    },
    "optionalDependencies": {
        "@laravel/multiplex": "^0.4.1",
        "@rollup/rollup-linux-x64-gnu": "4.9.5",
        "@rollup/rollup-win32-x64-msvc": "4.9.5",
        "@tailwindcss/oxide-linux-x64-gnu": "^4.0.1",
        "@tailwindcss/oxide-win32-x64-msvc": "^4.0.1",
        "lightningcss-linux-x64-gnu": "^1.29.1",
        "lightningcss-win32-x64-msvc": "^1.29.1"
    },
    "overrides": {
        "vite": "npm:@voidzero-dev/vite-plus-core@1.4.0"
    }
}
