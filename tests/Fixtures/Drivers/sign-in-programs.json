{
    "claude start": {
        "calls": [
            "argv: [--version]",
            "HOME={folder}",
            "CLAUDE_CONFIG_DIR={folder}",
            "CODEX_HOME=",
            "PATH_FIRST={base}/programs/accounts/no-keychain"
        ]
    },
    "claude status": {
        "calls": [
            "argv: [auth] [status] [--json]",
            "HOME={folder}",
            "CLAUDE_CONFIG_DIR={folder}",
            "CODEX_HOME=",
            "PATH_FIRST={base}/programs/accounts/no-keychain"
        ],
        "answer": {
            "isReadable": true,
            "isSignedIn": true,
            "method": "oauth",
            "email": "owner@example.test",
            "expiresAt": null
        }
    },
    "claude model check": {
        "calls": [
            "argv: [-p] [Reply with OK.] [--output-format] [json] [--max-turns] [1] [--tools] [] [--no-session-persistence]",
            "HOME={folder}",
            "CLAUDE_CONFIG_DIR={folder}",
            "CODEX_HOME=",
            "PATH_FIRST={base}/programs/accounts/no-keychain"
        ],
        "answer": null
    },
    "codex start": {
        "calls": [
            "argv: [--version]",
            "HOME={folder}",
            "CLAUDE_CONFIG_DIR=",
            "CODEX_HOME={folder}",
            "PATH_FIRST={base}/vendor/bin"
        ],
        "config.toml": "cli_auth_credentials_store = \"file\"\n"
    },
    "codex status": {
        "calls": [
            "argv: [login] [status]",
            "HOME={folder}",
            "CLAUDE_CONFIG_DIR=",
            "CODEX_HOME={folder}",
            "PATH_FIRST={base}/vendor/bin"
        ],
        "answer": {
            "isReadable": true,
            "isSignedIn": false,
            "method": null,
            "email": null,
            "expiresAt": null
        }
    },
    "codex model check": {
        "calls": [
            "argv: [exec] [--json] [--skip-git-repo-check] [Reply with OK.]",
            "HOME={folder}",
            "CLAUDE_CONFIG_DIR=",
            "CODEX_HOME={folder}",
            "PATH_FIRST={base}/vendor/bin"
        ],
        "answer": null
    },
    "codex sign-out": {
        "calls": [
            "argv: [logout]",
            "HOME={folder}",
            "CLAUDE_CONFIG_DIR=",
            "CODEX_HOME={folder}",
            "PATH_FIRST={base}/vendor/bin"
        ]
    }
}
