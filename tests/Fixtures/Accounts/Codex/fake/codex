#!/bin/sh
# A stand-in for the codex command: a CODEX_HOME holding auth.json is signed in, and mcp list names the hostile
# server when the working folder is trusted and holds its own .codex/config.toml.
case "$1" in
    --version) echo "codex-cli 0.165.0" ;;
    --help) echo "Commands: exec app-server login mcp" ;;
    exec)
        # exec --json sends one request: it completes when the kept key starts with valid, and fails as OpenAI refuses
        # a wrong key otherwise, naming the key and the request's address as Codex does.
        if [ "$2" != "--json" ]; then echo "Options: --add-dir <DIR> --json"; exit 0; fi
        echo '{"type":"thread.started","thread_id":"t-1"}'
        echo '{"type":"turn.started"}'
        key=$(cat "$CODEX_HOME/api-key" 2>/dev/null)
        case "$key" in
            valid*) echo '{"type":"turn.completed","usage":{"input_tokens":1,"output_tokens":1}}' ;;
            *)
                echo '{"type":"error","message":"Reconnecting... 1/5 (unexpected status 401 Unauthorized)"}'
                echo "{\"type\":\"turn.failed\",\"error\":{\"message\":\"unexpected status 401 Unauthorized: Incorrect API key provided: $key. You can find your API key at https://platform.openai.com/account/api-keys., url: https://api.openai.com/v1/responses, request id: req_1\"}}"
                ;;
        esac
        ;;
    login)
        # login --with-api-key reads the key on stdin and keeps any key unchecked, as Codex does; only a request checks
        # it. login status names how the folder is signed in.
        if [ "$2" = "--with-api-key" ]; then
            read -r key
            echo '{"OPENAI_API_KEY":"kept"}' > "$CODEX_HOME/auth.json"
            printf '%s' "$key" > "$CODEX_HOME/api-key"
            touch "$CODEX_HOME/api-key-mode"
            echo "API key saved. Authentication is checked when you send a request."
            exit 0
        fi
        if [ ! -f "$CODEX_HOME/auth.json" ]; then echo "Not logged in"; exit 1; fi
        if [ -f "$CODEX_HOME/api-key-mode" ]; then echo "API key configured - ***"; else echo "Logged in using ChatGPT"; fi
        ;;
    logout)
        rm -f "$CODEX_HOME/auth.json" "$CODEX_HOME/api-key-mode" "$CODEX_HOME/api-key"
        ;;
    app-server)
        # Answers the device-code start, announces another login's completion first, then signs the folder in and
        # announces its own, answers account/read, and serves until stdin closes. Files in CODEX_HOME change it:
        # login-fails fails the login, only-other-login completes another login only, account-type names the
        # account/read type and no-account-read ends without answering account/read.
        while read -r line; do
            case "$line" in
                *account/login/start*)
                    echo '{"id":1,"result":{"type":"chatgptDeviceCode","loginId":"login-1","userCode":"ABCD-1234","verificationUrl":"https://auth.openai.com/codex/device"}}'
                    echo '{"method":"account/login/completed","params":{"success":true,"loginId":"login-0"}}'
                    if [ -f "$CODEX_HOME/only-other-login" ]; then continue; fi
                    success=true
                    if [ -f "$CODEX_HOME/login-fails" ]; then success=false; fi
                    if [ "$success" = true ]; then echo '{"tokens":"fake-secret-token"}' > "$CODEX_HOME/auth.json"; fi
                    echo "{\"method\":\"account/login/completed\",\"params\":{\"success\":$success,\"loginId\":\"login-1\"}}"
                    ;;
                *account/read*)
                    if [ -f "$CODEX_HOME/no-account-read" ]; then exit 0; fi
                    type=chatgpt
                    if [ -f "$CODEX_HOME/account-type" ]; then type=$(cat "$CODEX_HOME/account-type"); fi
                    echo "{\"id\":2,\"result\":{\"account\":{\"type\":\"$type\",\"email\":\"user@example.test\",\"planType\":\"plus\"},\"requiresOpenaiAuth\":true}}"
                    ;;
            esac
        done
        ;;
    mcp)
        here=$(pwd -P)
        if [ -f "$here/.codex/config.toml" ] && grep -q "\"$here\"" "$CODEX_HOME/config.toml"; then
            echo "hostile  true  enabled"
        else
            echo "No MCP servers configured yet."
        fi
        ;;
esac
