#!/bin/sh
# A mock for curl in tests: every address answers with an empty page and the call is recorded in
# $STAND_IN/requests.log; a download of the update script gets the project's own.
set -eu
here=$(dirname "$0")
project=$here/../../../..
. "$project/scripts/lib/arguments.sh"

main() {
    printf '%s\n' "$*" >> "$STAND_IN/requests.log"
    case "$*" in
        *"/.docker/updater/update.sh -o "*) cp "$project/.docker/updater/update.sh" "$(read_option -o "$@")" ;;
    esac
}

main "$@"
