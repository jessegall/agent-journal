{
    "preset": "laravel",
    "rules": {
        "declare_strict_types": true,
        "nullable_type_declaration": {
            "syntax": "union"
        },
        "nullable_type_declaration_for_default_null_value": true,
        "ordered_types": {
            "null_adjustment": "always_last",
            "sort_algorithm": "none"
        }
    },
    "exclude": [
        ".journal"
    ],
    "notPath": [
        "tests/Fixtures"
    ]
}
