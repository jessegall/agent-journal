{
  "manifest_version": 3,
  "name": "Agent journal",
  "version": "1.2.5",
  "description": "Point at anything on a page and send it to the agent's journal, with a picture of what you pointed at.",
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "tabs"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Agent journal",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png"
    }
  },
  "commands": {
    "point": {
      "suggested_key": {
        "default": "Alt+P"
      },
      "description": "Point at an element and send it to the journal"
    },
    "chat": {
      "suggested_key": {
        "default": "Alt+J"
      },
      "description": "Open the journal chat"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "http://127.0.0.1/*",
        "http://localhost/*"
      ],
      "js": [
        "bridge.js"
      ],
      "all_frames": true,
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  }
}
