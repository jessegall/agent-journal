# code-commandments skill library (regenerated on composer update)
.agents/skills/commandments-*/

# code-commandments published skills (regenerated on composer update)
.claude/skills/commandments-*

# The private shell corpus for full-corpus qualification (doc 21 section 35); never committed.
/corpus/

# Compose secret files of the contained arrangement; only secrets/README.md is committed.
secrets/*
!secrets/README.md

# The saved agent and runner images .docker/helper/build.sh writes for the agent daemon to load.
/images/
/.installed-commit
/.failed-commit

# The journal-agent scripts/dev-watch-host.sh builds for the local containers.
/.build

# Pictures and reports of tools/design-compare
/storage/design-compare/
/storage/acceptance/

/_ide_helper.php
/_ide_helper_models.php
/.phpstorm.meta.php
/_ide_helper_scopes.php

# What the app and the tools write at run time; only the folder skeleton, kept by its .gitignore files, is tracked
/storage/*
!/storage/app/
!/storage/framework/
!/storage/logs/
/storage/framework/*.txt
